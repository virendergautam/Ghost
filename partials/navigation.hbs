{{!-- saffffffffffffffffffffffffffffffffffffffffffffffff------------------------------------------------------------------------------- --}}


<ul id="siteNav" class="flex flex-wrap items-center gap-6">
  {{#foreach navigation}}
    <li class="nav-item relative" data-nav-item>
      <a class="nav-link inline-flex items-center gap-2 text-sm font-medium text-black"
         href="{{url}}">
        {{label}}
      </a>
    </li>
  {{/foreach}}
</ul>

<script>
(function () {
  if (location.pathname.startsWith('/ghost/')) return;

  const nav = document.getElementById('siteNav');
  if (!nav) return;

  const items = Array.from(nav.querySelectorAll('[data-nav-item]'));

  // Remove [group] from label text
  function cleanLabel(text) {
    return text.replace(/\s*\[.+?\]/, '').trim();
  }

  // Extract group name from label
  function extractGroup(text) {
    const match = text.match(/\[(.+?)\]/);
    return match ? match[1].toLowerCase() : null;
  }

  // Build nav data
  const navData = items.map(li => {
    const a = li.querySelector('a');
    const rawLabel = a ? a.textContent.trim() : '';
    const label = cleanLabel(rawLabel);

    if (a) a.textContent = label; // 🔥 CLEAN LABEL IN DOM

    return {
      li,
      a,
      rawLabel,
      label
    };
  });

  // Map parents by label
  const parentsByLabel = {};
  navData.forEach(item => {
    if (item.label) {
      parentsByLabel[item.label.toLowerCase()] = item;
    }
  });

  // Build parent → children map
  const childrenMap = new Map();

  navData.forEach(item => {
    const group = extractGroup(item.rawLabel);
    if (!group) return;

    const parent = parentsByLabel[group];
    if (!parent) return;

    if (!childrenMap.has(parent.li)) {
      childrenMap.set(parent.li, []);
    }
    childrenMap.get(parent.li).push(item.li);
  });

  // Create dropdowns
  for (const [parentLI, childLIs] of childrenMap.entries()) {
    const parentA = parentLI.querySelector('a');
    if (!parentA || !childLIs.length) continue;

    parentLI.classList.add('has-dropdown');

    // Add caret icon once
    if (!parentA.querySelector('[data-caret]')) {
      parentA.insertAdjacentHTML('beforeend', `
        <svg data-caret class="h-4 w-4 opacity-70" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd"/>
        </svg>
      `);
    }

    const dropdown = document.createElement('ul');
    dropdown.className =
      'absolute left-0 top-full z-50 mt-2 min-w-56 rounded-xl border border-neutral-200 bg-white p-2 shadow-lg ' +
      'opacity-0 invisible translate-y-1 transition';

    childLIs.forEach(childLI => {
      const childA = childLI.querySelector('a');
      if (!childA) return;

      const li = document.createElement('li');
      const a = childA.cloneNode(true);
      a.className = 'block rounded-lg px-3 py-2 text-sm text-neutral-800 hover:bg-neutral-100';

      li.appendChild(a);
      dropdown.appendChild(li);

      // Remove from top-level
      childLI.remove();
    });

    parentLI.appendChild(dropdown);

    // CLICK TO TOGGLE
    parentA.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();

      document.querySelectorAll('#siteNav li.is-open').forEach(li => {
        if (li !== parentLI) li.classList.remove('is-open');
      });

      parentLI.classList.toggle('is-open');
    });
  }

  // CLICK OUTSIDE TO CLOSE
  document.addEventListener('click', function () {
    document.querySelectorAll('#siteNav li.is-open')
      .forEach(li => li.classList.remove('is-open'));
  });

})();
</script>

<style>
#siteNav li.is-open > ul {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
</style>
