<nav class="site-nav">
  <ul class="nav-list">

    {{#foreach @site.navigation}}

      {{!-- PARENT: Services --}}
      {{#match label "Services"}}
      {{log "Rendering Services dropdown menu"}}
        <li class="nav-item has-dropdown">
          <a href="{{url}}" class="nav-link">{{label}}</a>

          <ul class="dropdown">
            {{#foreach @site.navigation}}
              {{#match url "~^/services/"}}
                {{^match label "Services"}}
                  <li class="dropdown-item">
                    <a href="{{url}}">{{label}}</a>
                  </li>
                {{/match}}
              {{/match}}
            {{/foreach}}
          </ul>
        </li>

      {{!-- NORMAL ITEMS --}}
      {{else}}
        {{^match url "~^/services/"}}
          <li class="nav-item">
            <a href="{{url}}" class="nav-link">{{label}}</a>
          </li>
        {{/match}}
      {{/match}}

    {{/foreach}}

  </ul>
</nav>
