<a href="{{url}}" class="group recommended-post-item" data-aos="fade-up" data-aos-duration="600" data-aos-delay="200">
    <div class="bg-secondary-bg rounded-xl border border-secondary-border p-5 h-full group">
        <div class="rounded-xl mb-5 overflow-hidden relative h-70">
            {{#if feature_image}}
            <img src="{{feature_image}}" class="transition-transform duration-500 group-hover:scale-105" alt="{{slug}}">
            {{else}}
            <img src="/assets/images/no-image.png" class="transition-transform duration-500 group-hover:scale-105"
                alt="No Image">
            {{/if}}
            {{#if primary_tag}}
            <div
                class="absolute top-4 left-4 text-xs bg-white/30 text-white backdrop-blur-sm border border-white/10 rounded-3xl px-3 py-1">
                <div class="overflow-hidden relative">
                    <div class="group-hover:translate-y-[-120%] transition-transform duration-500">{{primary_tag.name}}</div>
                    <div class="absolute bottom-[-100%] group-hover:bottom-[0] duration-500 transition-bottom">{{primary_tag.name}}</div>
                </div>
            </div>
            {{/if}}
        </div>
        <div class="recommended-post-item-content">
            <div class="recommended-post-meta flex items-center gap-2.5 mb-4">
                <span class="recommended-post-date text-xs">
                    {{date format="MMMM DD, YYYY"}}
                </span>
                {{#if reading_time}}
                <span class="bg-primary-bg px-2.5 py-1.5 rounded-3xl text-xs font-medium">{{reading_time}}</span>
                {{/if}}
            </div>
            <h2 class="text-lg font-semibold mb-4">{{title}}</h2>
            <p class="text-sm break-all">{{excerpt}}</p>
        </div>
    </div>
</a>