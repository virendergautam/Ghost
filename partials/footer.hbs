<footer class="bg-primary-bg">
  <div class="bg-secondary-bg rounded-tl-[30px] md:rounded-tl-[50px] rounded-tr-[30px] md:rounded-tr-[50px] pt-16">
    <div class="container mx-auto">
      <div class="flex flex-wrap">
        <div class="flex-[0_0_100%] md:flex-[0_0_50%] lg:flex-[0_0_30%] pr-0 md:pr-12.5 lg:pr-25 mb-10 md:mb-0">
          <div class="footer-logo mb-2.5 w-25">
            <a class="site-header-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
              {{#if @site.logo}}
              <img src="{{@site.logo}}" alt="{{@site.title}}">
              {{else}}
              {{@site.title}}
              {{/if}}
            </a>
          </div>
          <p>From ocean dives to sky trekking, we guide you through unforgettable travel experiences filled with
            adventure, discovery, and lasting memories.</p>
        </div>

        <div id="footerGrid" class="flex-[0_0_100%] md:flex-[0_0_50%] lg:flex-[0_0_45%] grid gap-10 md:grid-cols-3">
        </div>
        <div class="md:flex-[0_0_100%] lg:flex-[0_0_25%] lg:ml-auto mt-10 md:mt-10 lg:mt-0">
          <h4 class="text-base font-bold mb-6">
            Subscribe to our newsletter
          </h4>
          <p class="text-sm mb-6">
            Join our newsletter to stay up to date on features and releases.
          </p>
          <form
            class="grid grid-cols-(--my-grid-cols) bg-transparent rounded-full border border-secondary-border p-[3px] h-[50px] overflow-hidden">
            <input type="email" class="min-w-0 flex-1 px-4 text-sm bg-transparent outline-none"
              placeholder="Enter your email" />
            <button type="submit" class="button px-6 py-2 text-sm font-semibold h-full text-white rounded-full cursor-pointer">
              Subscribe
            </button>
          </form>
        </div>
      </div>
      <div
        class="border-t border-secondary-border mt-10 py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
        <p>© 2025 Shine. Published with Ghost and Shine Themes.</p>

        <!-- Social icons (placeholder SVGs) -->
        <div class="flex items-center gap-2">
          <!-- Facebook -->
          <a href="#" aria-label="Facebook" class="flex items-center justify-center w-6 h-6 hover:text-[var(--theme-accent-color)]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13 22v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3V3h-3a5 5 0 0 0-5 5v3H6v4h3v7h4z" />
            </svg>
          </a>
          <!-- X / Twitter -->
          <a href="#" aria-label="X" class="flex items-center justify-center w-6 h-6 hover:text-[var(--theme-accent-color)]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.1 3H20l-6.6 7.5L20.7 21H16l-4.3-5.7L7 21H4.1l7-7.9L3.7 3H8l3.8 5.1L17.1 3z" />
            </svg>
          </a>
          <!-- Instagram -->
          <a href="#" aria-label="Instagram" class="flex items-center justify-center w-6 h-6 hover:text-[var(--theme-accent-color)]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zM17.75 6a1.25 1.25 0 1 1-1.25 1.25A1.25 1.25 0 0 1 17.75 6z" />
            </svg>
          </a>
          <!-- TikTok -->
          <a href="#" aria-label="TikTok" class="flex items-center justify-center w-6 h-6 hover:text-[var(--theme-accent-color)]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M19 7.1a4.5 4.5 0 0 1-2.7-1.3A4.7 4.7 0 0 1 15 3h-2v12.1A2.4 2.4 0 0 1 10.6 17 2.6 2.6 0 0 1 8 14.4 2.6 2.6 0 0 1 10.6 12a2.3 2.3 0 0 1 1.1.3V9.2a5.2 5.2 0 0 0-1.1-.1 5.4 5.4 0 0 0-5.6 5.3A5.3 5.3 0 0 0 10.6 20 5.1 5.1 0 0 0 16 15V9.6a6.5 6.5 0 0 0 3 1z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<div id="footerNavSource" hidden>
  {{navigation type="secondary"}}
</div>

<script>
  (function () {
    const source = document.querySelector('#footerNavSource ul');
    const target = document.getElementById('footerGrid');
    if (!source || !target) return;

    const items = Array.from(source.querySelectorAll('li'));

    let currentCol = null;

    items.forEach(li => {
      const a = li.querySelector('a');
      if (!a) return;

      const label = a.textContent.trim();
      const url = a.getAttribute('href');

      // 🔹 COLUMN HEADING
      if (label.startsWith('#')) {
        currentCol = document.createElement('div');
        currentCol.innerHTML = `
        <h4 class="text-base font-bold mb-6">
          ${label.replace(/^#+\s*/, '')}
        </h4>
        <ul class="space-y-2 text-sm"></ul>
      `;
        target.appendChild(currentCol);
        return;
      }

      // 🔹 NORMAL LINK
      if (!currentCol) return;

      const ul = currentCol.querySelector('ul');
      const liEl = document.createElement('li');

      liEl.innerHTML = `
      <a href="${url}" class="hover:text-[var(--theme-accent-color)]">
        ${label}
      </a>
    `;

      ul.appendChild(liEl);
    });
  })();
</script>