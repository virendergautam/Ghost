{{!-- Pricing Card (Ghost compatible, no #let) --}}
<article
  class="relative rounded-3xl border p-8 {{#if featured}}bg-orange-500 text-white border-orange-500 shadow-lg{{else}}bg-white text-gray-900 border-gray-200 shadow-sm{{/if}}"
  data-plan="{{name}}"
  {{#if monthly_price}}data-monthly="{{price monthly_price}}"{{/if}}
  {{#if yearly_price}}data-yearly="{{price yearly_price}}"{{/if}}
  data-monthly-suffix="/ per month"
  data-yearly-suffix="/ per year"
>

  <div class="flex items-start gap-3">
    <span class="inline-flex h-9 w-9 items-center justify-center rounded-full {{#if featured}}bg-black/20{{else}}bg-gray-100{{/if}}">
      {{#if featured}}👑{{else}}⭐{{/if}}
    </span>

    <div>
      <h3 class="text-lg font-semibold leading-none">{{name}}</h3>
      {{#if description}}
        <p class="mt-2 text-sm {{#if featured}}text-white/90{{else}}text-gray-600{{/if}}">
          {{description}}
        </p>
      {{/if}}
    </div>
  </div>

  <div class="mt-8">
    <div class="flex items-end gap-2">
      <div class="text-4xl font-bold leading-none js-price">
        {{#if monthly_price}}
          {{price monthly_price}}
        {{else}}
          {{#if yearly_price}}
            {{price yearly_price}}
          {{else}}
            —
          {{/if}}
        {{/if}}
      </div>

      <div class="pb-1 text-sm js-suffix {{#if featured}}text-white/90{{else}}text-gray-600{{/if}}">
        {{#if monthly_price}}/ per month{{else}}{{#if yearly_price}}/ per year{{/if}}{{/if}}
      </div>
    </div>
  </div>

  <div class="mt-8 border-t pt-6 {{#if featured}}border-white/20{{else}}border-gray-200{{/if}}">
    <p class="text-sm font-semibold">Features</p>

    {{#if benefits}}
      <ul class="mt-4 space-y-3 text-sm">
        {{#foreach benefits}}
          <li class="flex gap-3">
            <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full {{#if ../featured}}bg-white/20{{else}}bg-gray-100{{/if}}">
              ✓
            </span>
            <span class="{{#if ../featured}}text-white/90{{else}}text-gray-700{{/if}}">
              {{this}}
            </span>
          </li>
        {{/foreach}}
      </ul>
    {{else}}
      <p class="mt-3 text-sm {{#if featured}}text-white/90{{else}}text-gray-600{{/if}}">
        Add benefits for this tier in Ghost Admin.
      </p>
    {{/if}}
  </div>

  <div class="mt-10">
    <a
      href="/signup/"
      data-portal="signup"
      class="inline-flex w-full items-center justify-center rounded-full px-5 py-3 text-sm font-semibold
             {{#if featured}}bg-white text-gray-900{{else}}bg-gray-900 text-white{{/if}}"
    >
      {{#if featured}}Sign Up Now{{else}}Sign up{{/if}}
    </a>
  </div>
</article>
