<article
  class="relative rounded-3xl border border-gray-200 bg-white p-8 text-gray-900 shadow-sm"
  data-plan="{{name}}"
  {{#if monthly_price}}data-monthly="{{price monthly_price}}"{{/if}}
  {{#if yearly_price}}data-yearly="{{price yearly_price}}"{{/if}}
  data-monthly-suffix="/ per month"
  data-yearly-suffix="/ per year"
>
  <div class="flex items-start gap-3">
    <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-gray-100">⭐</span>
    <div>
      <h3 class="text-lg font-semibold leading-none">{{name}}</h3>
      {{#if description}}
        <p class="mt-2 text-sm text-gray-600">{{description}}</p>
      {{/if}}
    </div>
  </div>

  <div class="mt-8 flex items-end gap-2">
    <div class="text-4xl font-bold leading-none js-price">
      {{#if monthly_price}}{{price monthly_price}}{{else}}{{#if yearly_price}}{{price yearly_price}}{{else}}0{{/if}}{{/if}}
    </div>
    <div class="pb-1 text-sm text-gray-600 js-suffix">
      {{#if monthly_price}}/ per month{{else}}{{#if yearly_price}}/ per year{{/if}}{{/if}}
    </div>
  </div>

  <div class="mt-8 border-t border-gray-200 pt-6">
    <p class="text-sm font-semibold">Features</p>

    {{#if benefits}}
      <ul class="mt-4 space-y-3 text-sm">
        {{#foreach benefits}}
          <li class="flex gap-3">
            <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-gray-100">✓</span>
            <span class="text-gray-700">{{this}}</span>
          </li>
        {{/foreach}}
      </ul>
    {{else}}
      <p class="mt-3 text-sm text-gray-600">
        Add benefits for this tier in Ghost Admin.
      </p>
    {{/if}}
  </div>

  <div class="mt-10">
    <a
      href="/signup/"
      data-portal="signup"
      class="inline-flex w-full items-center justify-center rounded-full bg-gray-900 px-5 py-3 text-sm font-semibold text-white"
    >
      Sign up
    </a>
  </div>
</article>
