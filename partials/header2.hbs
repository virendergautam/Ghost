<header id="siteHeader" data-header-style="{{@custom.header_layout}}" class="header-main [background:var(--gradient-tertiary-bg)] text-tertiary-text border-b border-tertiary-text">
    <div class="container mx-auto">
        <div
            class="header-inner z-1 grid items-center grid-cols-[1fr_1fr] lg:grid-cols-[1fr_auto_1fr] gap-8 py-5">
            <nav class="header-menu hidden lg:block">
                {{navigation}}
                <div
                    class="header-nav-account-links flex gap-4 items-center lg:hidden border-t border-[#EBEBEB] mt-10 pt-10">
                    {{#if @member}}
                    <a href="javascript:void(0)" data-members-signout
                        class="px-5 py-2 text-sm font-medium rounded-full bg-black dark:bg-white dark:text-black text-white hover:bg-[#FF7044] transition">
                        Sign Out
                    </a>
                    {{else}}
                    <a href="#/portal/signin" class="inline-flex text-sm text-black">Sign In</a>

                    <a href="#/portal/signup"
                        class="hidden lg:inline-flex items-center px-5 py-2 min-h-11 text-sm font-medium rounded-full bg-black text-white hover:text-white hover:bg-accent-bg transition">
                        Become a Subscriber
                    </a>
                    {{/if}}
                </div>
            </nav>

            <div class="header-logo w-25">
                <a class="site-header-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
                    {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                    {{@site.title}}
                    {{/if}}
                </a>
            </div>

            <!-- RIGHT SECTION -->
            <div class="flex items-center gap-3 ml-auto">
                <button
                    class="gh-search w-6 h-6 md:w-9.5 md:h-9.5 flex items-center justify-center rounded-full hover:bg-white hover:text-black cursor-pointer"
                    data-ghost-search>{{> "icons/search"}}
                </button>

