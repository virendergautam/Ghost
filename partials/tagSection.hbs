<section class="explore-tags py-20 rounded-tl-[60px] rounded-tr-[60px] relative mt-[-60px] bg-primary-bg">
    <div class="container mx-auto">
        <div class="explore-tags-wrapper">
            {{#get "pages" filter="tag:hash-section-tag-cards" limit="1"}}
            {{#if pages}}
            {{#foreach pages}}
            <div class="explore-tags-header mb-12.5 max-w-[676px] m-auto text-center">
                {{#if excerpt}}
                <div
                    class="inline-flex items-center justify-center rounded-full border border-secondary-border bg-secondary-bg px-5 py-2 text-xs mb-7.5">
                    {{excerpt}}
                </div>
                {{/if}}
                {{#if title}}
                <h2 class="text-2xl md:text-5xl font-semibold"> {{title}}</h2>
                {{/if}}
            </div>
            {{/foreach}}
            {{/if}}
            {{/get}}
            <div class="grid grid-cols-4 gap-7">
                {{#get "tags" filter="visibility:public" limit="4" include="count.posts"}} {{#foreach tags}}
                <a href="/tag/{{slug}}/" class="relative block rounded-2xl overflow-hidden group explore-tags-item" {{#if @even}}data-aos="fade-up" data-aos-duration="600"  {{/if}}
    {{#if @odd}}data-aos="fade-down" data-aos-duration="1200" {{/if}}>
                    <div class="aspect-square">
                        <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                            alt="{{name}}"
                            class="object-cover transition-transform duration-500 group-hover:scale-105" />
                    </div>
                    <div class="absolute inset-0 flex justify-between items-end p-4.5">
                        <div class="bg-white px-6 py-2.5 rounded-3xl">
                            <div class="h-5 overflow-hidden">
                                <div class="group-hover:translate-y-[-50%] transition-transform duration-500">
                                    <h3 class="font-medium text-sm md:text-base break-all text-black">
                                        {{name}}
                                    </h3>
                                    <h3 class="font-medium text-sm md:text-base break-all text-black">
                                        {{name}}
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <p class="text-xs md:text-base text-white bg-white/20 backdrop-blur-xl px-5 py-2.5 rounded-3xl">
                            {{plural count.posts empty="0 Articles" singular="1 Article" plural="% Articles"}}
                        </p>
                    </div>
                </a>
                {{/foreach}} {{/get}}
            </div>
        </div>
    </div>
</section>