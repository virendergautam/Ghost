<section class="team-section bg-primary-bg pt-10 pb-15 md:pb-20 relative border-t border-primary-border">
  <div class="container-sm mx-auto">
    <div class="section-heading mb-7.5 md:mb-12.5 text-center" data-aos="fade-up" data-aos-duration="600">
      <h2 class="text-2xl md:text-[38px] font-bold">Meet The Team</h2>
    </div>
    <div class="team-member-wrapper team-member-animate flex flex-wrap mobile-swipe mobile-column-1">
      {{#get "authors" limit="all"}}
      {{#foreach authors}}
      <div
        class="group rounded-3xl overflow-hidden text-center team-member-item relative md:h-[430px] active transition-all duration-500 ease">
        <a href={{url}} class="block h-full">
          {{#if profile_image}}
          <img src="{{profile_image}}" alt="{{name}}" class="" />
          {{else}}
          <div class="w-full h-full rounded-3xl overflow-hidden flex justify-center items-center randomColorBox">
            <span class="font-bold text-2xl sm:text-4xl">
              {{~#split name separator=" " as |words|~}}
              {{~#foreach words~}}
              {{~#split this separator="" as |chars|~}}
              {{~#foreach chars~}}
              {{~#if @first~}}{{this}}{{~/if~}}
              {{~/foreach~}}
              {{~/split~}}
              {{~/foreach~}}
              {{~/split~}}
            </span>
          </div>
          {{/if}}
        </a>
        <div
          class="absolute inset-0 flex flex-col justify-end items-center p-5 pointer-events-none lg:opacity-0 lg:translate-y-5 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 ease-out group-[.active]:opacity-100 group-[.active]:translate-y-0">
          <div class="">
            <div class="text-base font-semibold text-white">{{name}}</div>
            <div class="mt-2 text-sm text-white">CEO & Founder</div>
          </div>
          <div class="author-profile-meta flex items-center justify-center gap-1.5 md:gap-2.5 mt-3 pointer-events-auto">
            {{#if website}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5 flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{website}}" target="_blank" rel="noopener"></a>
            {{/if}}

            {{#if twitter}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5  flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" twitter"}}" target="_blank" rel="noopener">{{> "icons/twitter"}}</a>
            {{/if}}

            {{#if facebook}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5  flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" facebook"}}" target="_blank" rel="noopener">{{> "icons/facebook"}}</a>
            {{/if}}

            {{#if linkedin}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5 flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" linkedin"}}" target="_blank" rel="noopener">{{> "icons/linkedin"}}</a>
            {{/if}}

            {{#if bluesky}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5  flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" bluesky"}}" target="_blank" rel="noopener">{{> "icons/bluesky"}}</a>
            {{/if}}

            {{#if threads}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5  flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" threads"}}" target="_blank" rel="noopener">
              {{> "icons/threads"}}</a>
            {{/if}}

            {{#if mastodon}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5  flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" mastodon"}}" target="_blank" rel="noopener">{{> "icons/mastodon"}}
            </a>
            {{/if}}

            {{#if tiktok}}
            <a class="cursor-pointer author-profile-social-link w-5.5 md:w-9.5 h-5.5 md:h-9.5  flex items-center justify-center rounded-full bg-white/60 hover:bg-black hover:text-white"
              href="{{social_url type=" tiktok"}}" target="_blank" rel="noopener">{{> "icons/tiktok"}}</a>
            {{/if}}

            {{#if youtube}}
