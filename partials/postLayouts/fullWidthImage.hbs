{{!< default}} {{#post}} 
<!-- image part -->
    <div class="post-image mt-[25px] md:h-[655px]">
        {{#if feature_image}}
        <img src="{{feature_image}}" alt="{{slug}}">
        {{else}}
        <img src="/assets/images/no-image.png" alt="No Image">
        {{/if}}
    </div>
    <div class="max-w-[1247px] mx-auto px-4">
        <!-- Header part -->
        <div class="max-w-[1215px] mx-auto pt-12 md:pt-10 pb-10 text-center">

            <!-- Tags -->
            <div class="flex flex-wrap justify-center gap-2 mb-6">
                {{#foreach tags}}
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-secondary-bg">
                    {{name}}
                </span>
                {{/foreach}}
            </div>

            <!-- Title -->
            <h1 class="text-[28px] md:text-4xl lg:text-[54px] font-bold mb-6 md:mb-10">
                {{title}}
            </h1>

            <!-- Excerpt -->
            <p class="text-base mb-6 md:mb-10">
                {{excerpt}}
            </p>

            <!-- Divider -->
            <div class="border-t border-primary-border my-6 md:my-8"></div>

            <!-- Author -->
            <div class="flex items-center justify-center gap-3 text-xs">
                {{#if primary_author.profile_image}}
                <div class="w-9.5 h-9.5 rounded-full overflow-hidden">
                    <img src={{primary_author.profile_image}} alt={{title}} />
                </div>
                {{/if}}
                <span>
                    by <span class="font-medium">{{primary_author.name}}</span>
                    &nbsp;•&nbsp; {{date published_at format="DD MMM YYYY"}} &nbsp;/&nbsp; {{reading_time}} min read
                </span>
            </div>

        </div>
    </div>
   
    {{/post}}