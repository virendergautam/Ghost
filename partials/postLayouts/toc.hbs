{{!< default}}
{{#post}}
  <div class="bg-secondary-bg text-secondary-text py-17.5 mt-[25px]">
    <div class="max-w-[1580px] mx-auto grid items-center grid-cols-1 lg:grid-cols-[.8fr_1fr] gap-10 lg:gap-20">
      <div class="text-left">
        <div class="flex flex-wrap gap-2 mb-6">
          {{#foreach tags}}
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-primary-bg text-primary-text">
              {{name}}
            </span>
          {{/foreach}}
        </div>
        <h1 class="text-[28px] md:text-4xl lg:text-[54px] font-bold mb-6 md:mb-10">
          {{title}}
        </h1>
        <p class="text-base">
          {{excerpt}}
        </p>
        <div class="border-t border-secondary-border mt-10 mb-5"></div>
        <div class="flex items-center gap-3 text-xs">
          {{#if primary_author.profile_image}}
            <div class="w-9.5 h-9.5 rounded-full overflow-hidden">
              <img src={{primary_author.profile_image}} alt={{title}} />
            </div>
          {{/if}}
          <span> by <span class="font-medium">{{primary_author.name}}</span> &nbsp;•&nbsp; {{date published_at format="DD MMM YYYY"}} &nbsp;/&nbsp; {{reading_time}}</span>
        </div>
      </div>
      <div class="rounded-3xl overflow-hidden h-[545px]">
        {{#if feature_image}}
          <img src="{{feature_image}}" alt="{{slug}}">
        {{else}}
          <img src="/assets/images/no-image.png" alt="No Image">
        {{/if}}
      </div>
    </div>
  </div>

{{/post}}