{{!< default}} 
    {{#post}} 
    <div class="bg-secondary-bg mt-[25px] py-10 md:py-17.5">
    <div class="container mx-auto">
        <div class="max-w-[1500px] mx-auto grid items-center grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20">
            <!-- Header part -->
            <div class="text-left">

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mb-6">
                    {{#foreach tags}}
                        <span class="px-3 py-1 text-xs font-medium rounded-full bg-primary-bg">
                            {{name}}
                        </span>
                    {{/foreach}}
                </div>

                <!-- Title -->
                <h1 class="text-[28px] md:text-4xl lg:text-[54px] font-bold mb-6 md:mb-10">
                    {{title}}
                </h1>

                <!-- Excerpt -->
                <p class="text-base">
                    {{excerpt}}
                </p>

                <!-- Divider -->
                <div class="border-t border-primary-border mt-10 mb-5"></div>

                <!-- Author -->
                <div class="flex items-center gap-3 text-xs">
                    {{#if primary_author.profile_image}}
                        <div class="w-9.5 h-9.5 rounded-full overflow-hidden">
                            <img src={{primary_author.profile_image}} alt={{title}} />
                        </div>
                    {{/if}}
                    <span>
                        by <span class="font-medium">{{primary_author.name}}</span>
                        &nbsp;•&nbsp; {{date published_at format="DD MMM YYYY"}} &nbsp;/&nbsp; {{reading_time}} min read
                    </span>
                </div>

            </div>

            <!-- image part -->
            <div class="rounded-3xl overflow-hidden md:h-[545px]">
                {{#if feature_image}}
                    <img src="{{feature_image}}" alt="{{slug}}">
                {{else}}
                    <img src="/assets/images/no-image.png" alt="No Image">
                {{/if}}
            </div>
        </div>
    </div>
    </div>
    {{/post}}