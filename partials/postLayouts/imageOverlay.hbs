{{!< default}} 
{{#post}} 
    <div class="container mx-auto">
        <div class="relative mt-[25px] h-[640px]">
            <!-- image part -->
            <div class="rounded-3xl overflow-hidden h-full">
                {{#if feature_image}}
                    <img src="{{feature_image}}" alt="{{slug}}">
                {{!-- {{else}} --}}
                    {{!-- <img src="/assets/images/no-image.png" alt="No Image"> --}}
                {{/if}}
            </div>
            <!-- Header part -->
            <div class="max-w-5xl mx-auto py-10 text-center absolute inset-0 flex flex-col content-center justify-center">

                <!-- Tags -->
                <div class="flex flex-wrap justify-center gap-2 mb-6">
                    {{#foreach tags}}
                        <span class="px-3 py-1 text-xs font-medium rounded-full bg-secondary-bg">
                            {{name}}
                        </span>
                    {{/foreach}}
                </div>

                <!-- Title -->
                <h1 class="text-[28px] md:text-4xl lg:text-[54px] font-bold mb-6 md:mb-10 text-white">
                    {{title}}
                </h1>

                <!-- Excerpt -->
                <p class="text-base text-white">
                    {{excerpt}}
                </p>

                <!-- Divider -->
                <div class="border-t border-[#EBEBEB] mt-10 mb-5 relative"></div>

                <!-- Author -->
                <div class="flex items-center justify-center gap-3 text-xs">
                    {{#if primary_author.profile_image}}
                        <div class="w-9.5 h-9.5 rounded-full overflow-hidden">
                            <img src={{primary_author.profile_image}} alt={{title}} />
                        </div>
                    {{/if}}
                    <span class="text-white">
                        by <span class="font-medium">{{primary_author.name}}</span>
                        &nbsp;•&nbsp; {{date published_at format="DD MMM YYYY"}} &nbsp;/&nbsp; {{reading_time}} min read
                    </span>
                </div>

            </div>
        </div>
    </div>
{{/post}}