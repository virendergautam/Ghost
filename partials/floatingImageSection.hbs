<section class="hidden md:block h-screen w-full overflow-hidden relative bg-primary-bg">
    <div class="bg-white/40 backdrop-blur-[50px] z-10 absolute left-0 bottom-0 w-full">
        <div class="container mx-auto">
            <div class="flex overflow-x-auto">
                {{#get "posts" include="authors,tags" limit="4"}}
                {{#foreach posts}}
                <a href="{{url}}"
                    class="group flex basis-1/4 gap-3 px-5 lg:px-8.5 py-5.5 cursor-pointer data-[attribute=true]:bg-white/10 transition border-t-2 hover:border-white data-[attribute=false]:border-transparent data-[attribute=true]:border-white"
                    data-bg="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}">

                    <div class="h-18.5 min-w-22.5 w-22.5 rounded-md overflow-hidden">
                        {{#if feature_image}}
                        <img src="{{feature_image}}" />
                        {{else}}
                        <img src="/assets/images/no-image.png">
                        {{/if}}
                    </div>
                    <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-2.5">
                            <span class="text-xs text-white">{{date published_at format="DD MMM YYYY"}} </span>
                            <div class="rounded-full bg-[#D6E8CB] text-black px-3 py-1 text-xs">
                                <div class="overflow-hidden relative">
                                    <div class="group-hover:translate-y-[-120%] transition-transform duration-500">{{primary_tag.name}}</div>
                                    <div class="absolute bottom-[-100%] group-hover:bottom-[0] duration-500 transition-bottom">{{primary_tag.name}}</div>
                                </div>
                            </div>
                        </div>
                        <h4 class="text-sm font-bold text-white mt-4 line-clamp-2"> {{title}}
                        </h4>
                    </div>
                </a>
                {{/foreach}}
                {{/get}}
            </div>
        </div>
    </div>
    <!-- RIGHT BACKGROUND -->
    <!-- RIGHT BACKGROUND -->
    <div class="absolute inset-0">
        <img id="hero-bg" src="/assets/images/no-image.png" alt=""
            class="h-full w-full object-cover transition-opacity duration-300" />
        <!-- Overlay -->
        <div class="absolute inset-0 bg-black/30"></div>
    </div>

</section>

<!-- Cards Grid -->
<section class="bg-primary-bg md:hidden block">
    <div class="floating-images-wrapper grid mobile-swipe">
        {{#get "posts" include="authors,tags" limit="4"}}
        {{#foreach posts}}
        <a href="{{url}}" class="flex items-end relative h-[550px] w-full group cursor-pointer">
            <div class="absolute inset-0">
                {{#if feature_image}}
                <img src="{{feature_image}}" />
                {{else}}
                <img src="/assets/images/no-image.png">
                {{/if}}
            </div>
            <div class="relative z-1 bg-white/40 backdrop-blur-[50px] flex gap-3 p-4 w-full">
                <div class="h-18.5 w-22.5 rounded-md overflow-hidden">
                    {{#if feature_image}}
                    <img src="{{feature_image}}" />
                    {{else}}
                    <img src="/assets/images/no-image.png">
                    {{/if}}
                </div>
                <div class="flex-1">
                    <p class="text-xs text-white">{{date published_at format="DD MMM YYYY"}} &nbsp;.&nbsp;
                        {{primary_author.name}}</p>
                    <h4 class="text-sm font-bold text-white mt-4 line-clamp-2"> {{title}}</h4>
                </div>
            </div>
        </a>
        {{/foreach}}
        {{/get}}
    </div>
    </div>
</section>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const heroBg = document.getElementById("hero-bg");
        const items = document.querySelectorAll("[data-bg]");

        // ✅ Set first post image by default
        if (items.length > 0) {
            const firstBg = items[0].getAttribute("data-bg");
            if (firstBg) {
                heroBg.src = firstBg;
            }
            items.forEach((item,key)=>{
                if(key == 0){
                  item.setAttribute("data-attribute","true");  
                }else{
                  item.setAttribute("data-attribute","false");  
                }
            })
        }

        // Hover interaction
        items.forEach(item => {
            item.addEventListener("mouseenter", () => {
                items.forEach(i => i.setAttribute("data-attribute", "false"));
                item.setAttribute("data-attribute", "true");
                const newBg = item.getAttribute("data-bg");
                if (!newBg || heroBg.src === newBg) return;

                heroBg.style.opacity = "0";
                setTimeout(() => {
                    heroBg.src = newBg;
                    heroBg.style.opacity = "1";
                }, 150);
            });
        });
    });
</script>