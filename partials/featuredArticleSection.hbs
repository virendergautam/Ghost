<section class="bg-primary-bg featured-blog pt-15 border-t border-primary-border">
    <div class="container mx-auto">
        {{#get "pages" filter="tag:hash-section-featured-post" limit="1"}}
        {{#if pages}}
        {{#foreach pages}}
        <div class="featured-blog mb-12.5 max-w-[676px] m-auto text-center">
            {{#if excerpt}}
            <div
                class="inline-flex items-center justify-center rounded-full border border-secondary-border bg-secondary-bg px-5 py-2 text-xs mb-7.5">
                {{excerpt}}
            </div>
            {{/if}}
            {{#if title}}
            <h2 class="text-2xl md:text-5xl font-bold">{{title}}</h2>
            {{/if}}
            <p class="text-base mt-5">{{content}}</p>
        </div>
        {{/foreach}}
        {{/if}}
        {{/get}}

        <div class="featured-blog-swiper rounded-4xl">
            {{#get "posts" filter="featured:true" limit ="1" include="authors,tags"}}
            {{#foreach posts}}
            <div class="featured-blog-wrapper relative">
                <div class="featured-blog-media rounded-4xl overflow-hidden h-[var(--media-height)]">
                    <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                        alt="{{title}}" />
                </div>

                <div
                    class="featured-blog-content absolute inset-0 p-4 md:p-8 flex flex-col justify-center items-center">
                    <div class="featured-blog-content-bottom max-w-[660px] flex items-center flex-col gap-y-6">
                        <!-- Tags -->
                        <div class="card-tags flex flex-wrap gap-2 justify-center">
                            {{#foreach tags}}
                            <a href="{{url}}"
                                class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-[#D6E8CB] text-black backdrop-blur-sm">
                                {{name}}
                            </a>
                            {{/foreach}}
                        </div>
                        <!-- Title -->
                        <h2 class="text-2xl md:text-4xl font-semibold text-white text-center">
                            <a href="{{url}}" class="hover:underline">
                                {{title}}
                            </a>
                        </h2>
                        <!-- Meta -->
                        <div class="featured-card-meta flex flex-wrap gap-x-4 items-center">
                            <div class="post-card-author flex gap-x-2 items-center">
                                {{#if primary_author.profile_image}}
                                <div class="w-[34px] h-[34px] rounded-full overflow-hidden">
                                    <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}"
                                        class="" />
                                </div>
                                {{/if}}
                                <div class="text-white text-xs">by {{primary_author.name}} / {{date published_at
                                    format="MMMM DD, YYYY"}}</div>
                            </div>
                            <div
                                class="post-card-time font-medium rounded-full bg-white/30 text-white backdrop-blur-sm text-xs py-[6px] px-[10px]">
                                {{reading_time}} min read
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/foreach}}
            {{/get}}

    
        </div>
    </div>
</section>



<!-- Wrapper (light gray section like screenshot) -->
<section class="bg-primary-bg pt-6 pb-12">
    <div class="container mx-auto">
        <!-- Cards row -->
        <div class="grid gap-2.5 md:grid-cols-3">
            {{#get "posts" filter="featured:true" limit="4" include="tags,authors" }}
            {{#foreach posts}}
            <!-- Card 1 -->
            {{#if @first}}
            {{else}}
            <article class="flex gap-4 rounded-[20px] border border-secondary-border bg-secondary-bg p-5">
                <div class="rounded-[20px] overflow-hidden w-[200px] h-[150px]">
                    <img class="h-20 w-28 rounded-xl object-cover"
                        src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                        alt="{{title}}" />
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        {{#if primary_tag}}
                        <span class="rounded-full bg-primary-bg px-3 py-1.5 font-medium">
                            {{primary_tag.name}}
                        </span>
                        {{/if}}
                        <span>{{date published_at format="MMM DD, YYYY"}}</span>
                    </div>

                    <h3 class="mt-5 text-base font-bold"> <a href="{{url}}" class="hover:underline">
                            {{title}}
                        </a></h3>
                    <p class="mt-5 text-sm">
                        {{excerpt words="18"}}
                    </p>
                </div>
            </article>
            {{/if}}
            {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>