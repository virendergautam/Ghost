<section class="bg-primary-bg featured-blog pt-15 border-t border-primary-border">
    <div class="container mx-auto">
        {{#get "pages" filter="tag:hash-section-featured-post" limit="1"}}
            {{#if pages}}
                {{#foreach pages}}
                    <div class="featured-blog mb-12.5 max-w-[676px] m-auto text-center">
                        {{#if excerpt}}
                            <div
                                class="inline-flex items-center justify-center rounded-full border border-secondary-border bg-secondary-bg px-5 py-2 text-xs mb-7.5">
                                {{excerpt}}
                            </div>
                        {{/if}}
                        {{#if title}}
                            <h2 class="text-2xl md:text-5xl font-bold">{{title}}</h2>
                        {{/if}}
                        <p class="text-base mt-5">{{content}}</p>
                    </div>
                {{/foreach}}
            {{/if}}
        {{/get}}

        <div class="swiper featured-blog-swiper rounded-4xl">
            <div class="swiper-wrapper">
                {{#get "posts" filter="featured:true" include="authors,tags"}}
                    {{#foreach posts}}
                        <div class="swiper-slide">
                            <div class="featured-blog-wrapper relative">
                                <div class="featured-blog-media rounded-4xl overflow-hidden h-[var(--media-height)]">
                                    <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                                        alt="{{title}}" />
                                </div>

                                <div class="featured-blog-content absolute inset-0 p-4 md:p-8 flex flex-col justify-center items-center">
                                    <div class="featured-blog-content-bottom max-w-[660px] flex items-center flex-col gap-y-6">
                                        <!-- Tags -->
                                        <div class="card-tags flex flex-wrap gap-2 justify-center">
                                            {{#foreach tags}}
                                                <a href="{{url}}"
                                                    class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-[#D6E8CB] text-black backdrop-blur-sm">
                                                    {{name}}
                                                </a>
                                            {{/foreach}}
                                        </div>
                                        <!-- Title -->
                                        <h2 class="text-2xl md:text-4xl font-semibold text-white text-center">
                                            <a href="{{url}}" class="hover:underline">
                                                {{title}}
                                            </a>
                                        </h2>
                                        <!-- Meta -->
                                        <div class="featured-card-meta flex flex-wrap gap-x-4 items-center">
                                            <div class="post-card-author flex gap-x-2 items-center">
                                                {{#if primary_author.profile_image}}
                                                <div class="w-[34px] h-[34px] rounded-full overflow-hidden">
                                                <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}"
                                                    class="" />
                                                    </div>
                                                {{/if}}
                                                <div class="text-white text-xs">by {{primary_author.name}} / {{date published_at format="MMMM DD, YYYY"}}</div>
                                            </div>
                                            <div
                                                class="post-card-time font-medium rounded-full bg-white/30 text-white backdrop-blur-sm text-xs py-[6px] px-[10px]">
                                                {{reading_time}} min read
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/foreach}}
                {{/get}}
            </div>
            <div
                class="swiper-navigation flex justify-between gap-3 absolute inset-0 px-5 items-center z-10 pointer-events-none">
                <button id="rec-swiper-btn-prev" type="button"
                    class="swiper-nav-prev swiper-button cursor-pointer min-w-[46px] min-h-[46px] bg-white/40 backdrop-blur-2xl rounded-full flex items-center justify-center pointer-events-auto">
                    <svg width="15" height="12" viewBox="0 0 15 12" fill="none">
                        <path
                            d="M13.3203 4.77344C13.7345 4.77344 14.0703 5.10922 14.0703 5.52344C14.0703 5.93765 13.7345 6.27344 13.3203 6.27344V5.52344V4.77344ZM0.219195 6.05377C-0.073698 5.76087 -0.073698 5.286 0.219195 4.99311L4.99217 0.220137C5.28506 -0.0727568 5.75993 -0.0727568 6.05283 0.220137C6.34572 0.51303 6.34572 0.987904 6.05283 1.2808L1.81019 5.52344L6.05283 9.76608C6.34572 10.059 6.34572 10.5338 6.05283 10.8267C5.75993 11.1196 5.28506 11.1196 4.99217 10.8267L0.219195 6.05377ZM13.3203 5.52344V6.27344L0.749525 6.27344V5.52344V4.77344L13.3203 4.77344V5.52344Z"
                            fill="#ffffff" />
                    </svg>
                </button>
                <button id="rec-swiper-btn-next" type="button"
                    class="swiper-nav-next swiper-button cursor-pointer min-w-[46px] min-h-[46px] bg-white/40 backdrop-blur-2xl rounded-full flex items-center justify-center pointer-events-auto">
                    <svg width="15" height="12" viewBox="0 0 15 12" fill="none">
                        <path
                            d="M0.75 4.77344C0.335786 4.77344 0 5.10922 0 5.52344C0 5.93765 0.335786 6.27344 0.75 6.27344V5.52344V4.77344ZM13.8511 6.05377C14.144 5.76087 14.144 5.286 13.8511 4.99311L9.07815 0.220137C8.78525 -0.0727568 8.31038 -0.0727568 8.01749 0.220137C7.72459 0.51303 7.72459 0.987904 8.01749 1.2808L12.2601 5.52344L8.01749 9.76608C7.72459 10.059 7.72459 10.5338 8.01749 10.8267C8.31038 11.1196 8.78525 11.1196 9.07815 10.8267L13.8511 6.05377ZM0.75 5.52344V6.27344L13.3208 6.27344V5.52344V4.77344L0.75 4.77344V5.52344Z"
                            fill="#ffffff" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>