<section class="bg-primary-bg featured-blog pt-10 md:pt-15 border-t border-primary-border relative">
    <div class="container mx-auto">
        {{#get "pages" filter="tag:hash-section-featured-post" limit="1"}}
        {{#if pages}}
        {{#foreach pages}}
        <div class="featured-blog mb-8 md:mb-12.5 max-w-[676px] m-auto text-center" data-aos="fade-up"
            data-aos-duration="1000">
            {{#if excerpt}}
            <div
                class="inline-flex items-center justify-center rounded-full border border-secondary-border bg-secondary-bg px-5 py-2 text-xs mb-4.5 md:mb-7.5">
                {{excerpt}}
            </div>
            {{/if}}
            {{#if title}}
            <h2 class="text-2xl md:text-5xl font-bold">{{title}}</h2>
            {{/if}}
            <div class="text-sm md:text-base mt-5">{{content}}</div>
        </div>
        {{/foreach}}
        {{/if}}
        {{/get}}

        <div class="featured-blog-swiper rounded-4xl">
            {{#get "posts" filter="featured:true" limit ="1" include="authors,tags"}}
            {{#foreach posts}}
            <div class="featured-blog-wrapper relative">
                <div class="featured-blog-media rounded-4xl overflow-hidden h-[var(--media-height)]"
                    data-aos="zoom-in-up" data-aos-duration="1000">
                    <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                        alt="{{title}}" />
                </div>

                <div
                    class="featured-blog-content absolute inset-0 p-4 md:p-8 flex flex-col justify-center items-center">
                    <div class="featured-blog-content-bottom max-w-[660px] flex items-center flex-col gap-y-6">
                        <!-- Tags -->
                        <div class="card-tags flex flex-wrap gap-2 justify-center">
                            {{#foreach tags}}
                            <a href="{{url}}"
                                class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-white text-black border border-[#dddddd] backdrop-blur-sm">
                                {{name}}
                            </a>
                            {{/foreach}}
                        </div>
                        <!-- Title -->
                        <h2 class="text-2xl md:text-4xl font-semibold text-white text-center">
                            <a href="{{url}}" class="hover:underline">
                                {{title}}
                            </a>
                        </h2>
                        <!-- Meta -->
                        <div class="featured-card-meta flex flex-wrap gap-x-4 items-center">
                            <div class="post-card-author flex gap-x-2 items-center">
                                {{#if primary_author.profile_image}}
                                <div class="w-[34px] h-[34px] rounded-full overflow-hidden">
                                    <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}"
                                        class="" />
                                </div>
                                {{/if}}
                                <div class="text-white text-xs">by {{primary_author.name}} / {{date published_at
                                    format="MMMM DD, YYYY"}}</div>
                            </div>
                            <div
                                class="post-card-time font-medium rounded-full bg-white/30 text-white backdrop-blur-sm text-xs py-[6px] px-[10px]">
                                {{reading_time}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/foreach}}
            {{/get}}


        </div>
    </div>
</section>

<!-- Wrapper (light gray section like screenshot) -->
<section class="bg-primary-bg pt-5 md:pt-6 pb-10 md:pb-12 relative">
    <div class="container mx-auto">
        <!-- Cards row -->
        <div class="grid gap-2.5 grid-cols-1 lg:grid-cols-3">
            {{#get "posts" filter="featured:true" limit="4" include="tags,authors" }}
            {{#foreach posts}}
            <!-- Card 1 -->
            {{#if @first}}
            {{else}}
            <article class="group flex gap-4 rounded-[20px] border border-secondary-border bg-secondary-bg p-3 xl:p-5" {{#if
                @even}}data-aos="fade-up" data-aos-duration="600" {{/if}} {{#if @odd}}data-aos="fade-up"
                data-aos-duration="600" {{/if}}>
                <div class="rounded-[14px] overflow-hidden w-[150px] h-[120px] xl:w-[200px] xl:h-[150px]">
                    <img
                        src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                        alt="{{title}}" />
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        {{#if primary_tag}}
                        <div class="rounded-full bg-primary-bg border border-primary-border px-3 py-1.5 font-medium">
                            <div class="overflow-hidden relative">
                                <div class="group-hover:translate-y-[-120%] transition-transform duration-500">
                                    {{primary_tag.name}}
                                </div>
                                <div class="absolute bottom-[-100%] group-hover:bottom-[0] duration-500 transition-bottom">
                                    {{primary_tag.name}}
                                </div>
                            </div>
                        </div>
                        {{/if}}
                        <span>{{date published_at format="MMM DD, YYYY"}}</span>
                    </div>

                    <h3 class="mt-2.5 xl:mt-5 text-sm md:text-base font-bold line-clamp-2"> <a href="{{url}}"
                            class="hover:underline">
                            {{title}}
                        </a></h3>
                    <p class="mt-2.5 xl:mt-4.5 text-xs md:text-sm line-clamp-2">
                        {{excerpt}}
                    </p>
                </div>
            </article>
            {{/if}}
            {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>