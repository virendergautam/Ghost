{{!-- Static Text Section --}}

{{#get "pages" filter="tag:hash-section-static-text" limit="1"}}
{{#if pages}}
{{#foreach pages}}
<div class="container mx-auto">
    {{#if title}}
    <h2 class="font-bold text-2xl md:text-5xl mb-10 text-center">{{title}}</h2>
    {{/if}}
    <div class="trust-icons-cards">
        {{content}}
    </div>
</div>
{{/foreach}}
{{/if}}
{{/get}}