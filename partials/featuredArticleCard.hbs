<div class="flex gap-4 border border-gray-200 rounded-2xl p-5 items-start">
  <div class="w-[var(--media-width)] h-[155px] rounded-2xl overflow-hidden">
       {{#if feature_image}}
      <img src="{{feature_image}}" alt="{{title}}">
    {{else}}
      <img src="{{asset "images/placeholder.jpg"}}" alt="placeholder">
    {{/if}}
  </div>

  <div class="flex-1">
    {{!-- <span class="text-xs bg-gray-100 px-3 py-1 rounded-full">Health</span> --}}
    <span class="text-xs bg-gray-100 px-3 py-1 rounded-full">{{primary_tag.name}}</span>

    {{!-- <h6 class="mt-[10px] text-xl font-semibold">
      The mind and body are not separate. what affects one, affects the other.
      what affects one, affects the other.
    </h6> --}}
    
   <h6 class="mt-[10px] text-xl font-semibold">
      <a href="{{url}}">{{title}}</a>
    </h6>
    <div class="flex items-center gap-2 mt-5 text-sm text-black">
      <div class="w-[34px] h-[34px] rounded-full overflow-hidden">
        {{!-- <img src="./assets/images/featured-blog.jpg" /> --}}
 {{!-- {{#if primary_author.profile_image}} --}}
        <div class="w-[34px] h-[34px] rounded-full overflow-hidden">
          <img src="{{primary_author.profile_image}}" alt="{{primary_author}}">
        </div>
      {{!-- {{/if}} --}}

      </div>
      {{!-- <span>by Breanaaaa Flatley / November 14, 2025</span> --}}
      <span>
        by {{primary_author.name}} /
        {{date format="MMMM DD, YYYY"}}
      </span>
    </div>
  </div>
</div>
