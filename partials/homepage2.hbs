<section class="bg-primary-bg py-10">
    <div class="container mx-auto">
        <div class="grid grid-cols-4 gap-6">
            {{#get "posts" include="authors,tags" limit="4"}}
            {{#foreach posts}}
            <a href="{{url}}" class="group flex gap-5 cursor-pointer"
                data-bg="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}">

                <div class="h-22.5 w-22.5 rounded-full overflow-hidden">
                    {{#if feature_image}}
                    <img src="{{feature_image}}" />
                    {{else}}
                    <img src="/assets/images/no-image.png">
                    {{/if}}
                </div>
                <div class="flex-1">
                    <p class="text-xs">{{date published_at format="DD MMM YYYY"}} &nbsp;.&nbsp;
                        {{primary_author.name}}</p>
                    <h4 class="text-base font-bold mt-4"> {{title}}</h4>
                </div>
                {{#unless @last}}
                <div class="hidden lg:block h-full w-px border-r border-primary-border"></div>
                {{/unless}}
            </a>
            {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>

<section class="pb-10 bg-primary-bg">
