<!-- Tailwind + Swiper (CDN) : Customer Review Slider -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<section class="bg-gradient-to-r from-slate-200 via-amber-50 to-orange-200 py-20">
    <!-- Heading -->
    <div class="text-center">
      <h2 class="text-4xl font-extrabold text-zinc-900">Customer Review</h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-zinc-600">
        Explore expert perspectives, emerging styles, and behind-the-scenes<br class="hidden sm:block" />
        stories that inspire the future .
      </p>
    </div>

    <!-- Slider -->
    <div class="mt-12">
      <div class="swiper reviewSwiper">
        <div class="swiper-wrapper">
          <!-- Slide -->
          <div class="swiper-slide">
            <article class="h-full rounded-3xl bg-white p-10 shadow-sm">
              <!-- stars -->
              <div class="flex gap-1 text-amber-400">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>

              <p class="mt-6 text-sm leading-7 text-zinc-800">
                “The customer service at Waned Roust Travels exceeded my expectations.
                Every detail was carefully thought out, ensuring a memorable.”
              </p>

              <div class="mt-10 flex items-center gap-4">
                <div class="w-14 h-14 rounded-full overflow-hidden">
                <img
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80"
                  alt=""
                />
                </div>
                <div>
                  <p class="font-semibold text-zinc-900">Michael Thompson</p>
                  <p class="text-sm text-zinc-500">Product Designer</p>
                </div>
              </div>
            </article>
          </div>

          <!-- Slide -->
          <div class="swiper-slide">
            <article class="h-full rounded-3xl bg-white p-10 shadow-sm">
              <div class="flex gap-1 text-amber-400">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>

              <p class="mt-6 text-sm leading-7 text-zinc-800">
                “I had an amazing experience with Waned roust Travels! Their personalized
                service trip unforgot. From stunning accompt to curated itineraries.”
              </p>

              <div class="mt-10 flex items-center gap-4">
                <div class="w-14 h-14 rounded-full overflow-hidden">
                <img
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80"
                  alt=""
                />
                </div>
                <div>
                  <p class="font-semibold text-zinc-900">Lucas Garcia</p>
                  <p class="text-sm text-zinc-500">Content Writer</p>
                </div>
              </div>
            </article>
          </div>

          <!-- Slide -->
          <div class="swiper-slide">
            <article class="h-full rounded-3xl bg-white p-10 shadow-sm">
              <div class="flex gap-1 text-amber-400">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>

              <p class="mt-6 text-sm leading-7 text-zinc-800">
                “My journey with Waned Roust Travels was nothing short of incredible.
                The team's dedication to creating memories made every moment special.”
              </p>

              <div class="mt-10 flex items-center gap-4">
                <div class="w-14 h-14 rounded-full overflow-hidden">
                <img
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80"
                  alt=""
                />
                </div>
                <div>
                  <p class="font-semibold text-zinc-900">Emily White</p>
                  <p class="text-sm text-zinc-500">Graphic Designer</p>
                </div>
              </div>
            </article>
          </div>

          <!-- Slide -->
          <div class="swiper-slide">
            <article class="h-full rounded-3xl bg-white p-10 shadow-sm">
              <div class="flex gap-1 text-amber-400">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>

              <p class="mt-6 text-sm leading-7 text-zinc-800">
                “Everything was seamless and premium. Booking, hotels, and the itinerary
                were all thoughtfully arranged. Highly recommended!”
              </p>

              <div class="mt-10 flex items-center gap-4">
                <div class="w-14 h-14 rounded-full overflow-hidden">
                <img
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80"
                  alt=""
                />
                </div>
                <div>
                  <p class="font-semibold text-zinc-900">David Lee</p>
                  <p class="text-sm text-zinc-500">Marketing Lead</p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>

      <!-- Custom nav (center bottom like screenshot) -->
      <div class="mt-10 flex items-center justify-center gap-4">
        <button
          class="reviewPrev grid h-10 w-10 place-items-center rounded-full bg-white shadow-sm transition hover:bg-zinc-100"
          aria-label="Previous"
        >
          ‹
        </button>
        <button
          class="reviewNext grid h-10 w-10 place-items-center rounded-full bg-white shadow-sm transition hover:bg-zinc-100"
          aria-label="Next"
        >
          ›
        </button>
      </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  new Swiper(".reviewSwiper", {
    loop: true,
    spaceBetween: 24,
    slidesPerView: 1.1,
    navigation: {
      nextEl: ".reviewNext",
      prevEl: ".reviewPrev",
    },
    breakpoints: {
      640: { slidesPerView: 1.2 },
      1024: { slidesPerView: 2.5 },
      1280: { slidesPerView: 3 },
    },
  });
</script>

