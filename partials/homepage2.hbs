<section class="recommended-post bg-primary-bg text-secondary-text py-10 md:py-20">
    <div class="container mx-auto">
        <div class="recommended-post-header mb-6 md:mb-12.5 text-center">
            <h2 class="text-2xl md:text-4xl font-semibold" data-aos="fade-up" data-aos-duration="600">Read Our
                Latest Posts </h2>
        </div>
        <div class="recommended-post-wrapper grid md:grid-cols-4 gap-5" id="postGrid">
         
            {{#get "posts" limit="4" include="tags"}}
            {{#foreach posts}}
            <div class="post-item">
                {{>"postCard2"}}
            </div>
            {{/foreach}}
            {{/get}}
        </div>

        <div class="mt-12 text-center">
            <button id="loadMoreBtn" style="cursor: pointer;" class="inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold
            bg-black text-white hover:bg-neutral-800 transition">
                Load more
            </button>
        </div>

    </div>
</section>

<section class=" relative py-10 min-h-[730px] flex items-center bg-accent-bg">
    <div class="background-image absolute inset-0">
        {{#if @site.cover_image}}
        <img class="site-header-cover" srcset="{{img_url @site.cover_image size=" s"}} 300w, {{img_url @site.cover_image
            size="m" }} 600w, {{img_url @site.cover_image size="l" }} 1000w, {{img_url @site.cover_image size="xl" }}
            2000w" sizes="100vw" src="{{img_url @site.cover_image size=" xl"}}" alt="{{@site.title}}" />
        {{/if}}
    </div>
    <div class="hero-content relative container mx-auto px-4 flex justify-start">
        <div class="max-w-[677px] text-left text-white">
            <h1 class="text-[28px] md:text-[34px] lg:text-[54px] font-semibold mb-4 md:mb-6">
                {{@custom.hero_heading}}
            </h1>
            <p class="text-base max-w-xl">{{@custom.hero_subheading}}</p>
            <form class="mt-6 md:mt-9">
                <div
                    class="grid grid-cols-(--my-grid-cols) max-w-[500px] bg-white rounded-full border border-white/20 min-h-[48px] p-1.5">
                    <input type="email" placeholder="Enter your email"
                        class="min-w-0 flex-1 bg-transparent px-4 text-sm text-black placeholder:text-black focus:outline-none" />
                    <button type="submit"
                        class="bg-black min-h-[42px] px-5 md:px-6.5 py-2.5 text-sm font-medium rounded-full cursor-pointer text-white">
                        Subscribe
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Blog Categories -->
<section class="bg-primary-bg py-16">
    <div class="mx-auto max-w-[1222px] px-4">
        <h2 class="text-center text-4xl font-bold">Blog Categories</h2>
        <div class="mt-12 grid gap-5 grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
            {{#get "tags" filter="visibility:public" limit="12" include="count.posts"}}
            {{#foreach tags}}
            <a href="/tag/{{slug}}/" class="catagory-card relative group grid h-45 place-items-center rounded-xl bg-secondary-bg overflow-hidden p-2.5">
                <div class="catagory_image absolute inset-0">
                    <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                        alt="{{name}}" class="object-cover transition-all duration-500 scale-125 group-hover:scale-100 opacity-0 group-hover:opacity-100" />
                </div>
                <div class="catagory-text-block text-center relative z-10 overflow-hidden">
                    <div class="catagory-text-wrapper">
                        <div class="catagory-text text-base font-medium group-hover:translate-y-[-100%] transition-transform duration-500">{{name}}<sup class="text-xs font-medium">({{count.posts}})</sup></div>
                        <div class="catagory-text text-base font-medium absolute bottom-[-100%] group-hover:bottom-[0] duration-500 transition-bottom">{{name}}<sup class="text-xs font-medium">({{count.posts}})</sup></div>
                    </div>
                </div>
                <div class="catagory-blank-bg bg-secondary-bg absolute inset-0 group-hover:opacity-0 transition-opacity duration-500"></div>
            </a>
            {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>

<section class="bg-secondary-bg py-20">
  <div class="mx-auto max-w-[1222px] px-4">
    <!-- Heading -->
    <h2 class="mb-10 text-center text-5xl font-bold">
      Some good words from my blog
    </h2>

    <div class="space-y-15">
        {{#get "posts" filter="featured:true" limit="3" include="tags,authors" }}
        {{#foreach posts}}
      <article class="grid gap-10 md:grid-cols-[auto_1fr]">
        <!-- Image -->
        <div class="relative overflow-hidden rounded-2xl w-[530px] h-[320px]">
            <div class="h-full w-full">
                <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                    alt="{{title}}" />
            </div>
          <div class="card-tags flex flex-wrap gap-2 justify-center absolute top-5 left-5">
            {{#foreach tags}}
            <a href="{{url}}"
                class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-white/20 backdrop-blur-2xl text-white border border-white/10">
                {{name}}
            </a>
            {{/foreach}}
        </div>
        </div>

        <!-- Content -->
        <div class="flex flex-col justify-center">
          <div class="mb-5 flex items-center gap-3 text-xs">
            <span>{{date published_at format="MMM DD, YYYY"}}</span>
            <span>•</span>
            {{#if reading_time}}
                <span class="bg-primary-bg px-2.5 py-1.5 rounded-3xl text-xs font-medium">{{reading_time}}</span>
            {{/if}}
          </div>

          <h3 class="text-[22px] font-bold">
           <a href="{{url}}" class="hover:underline">{{title}}</a>
          </h3>

          <p class="mt-5 max-w-xl text-base">
            {{excerpt words="50"}}
          </p>

          <div class="mt-6">
            <a
              href="#"
              class="inline-flex items-center justify-center rounded-full border border-secondary-border px-5 py-2 text-sm transition hover:bg-white hover:text-black"
            >
              Read More
            </a>
          </div>
        </div>
      </article>
       {{#unless @last}}
      <div class="h-px w-full bg-primary-bg"></div>
       {{/unless}}
        {{/foreach}}
        {{/get}}
    </div>
  </div>
</section>

