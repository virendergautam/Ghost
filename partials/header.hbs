<header id="siteHeader" data-header-style="{{@custom.header_layout}}" class="header-main">
    <div class="max-w-[1215px] w-[93%] mx-auto relative">
        <div
            class="header-inner z-1 flex items-center gap-8 absolute inset-x-0 bg-white/70 backdrop-blur-md border border-white/50 p-4.5 md:p-2.5 rounded-[50px] mt-[25px] md:pl-7.5">
            <div class="header-logo">
                <a class="site-header-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
                    {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                    {{@site.title}}
                    {{/if}}
                </a>
            </div>
            <!-- CENTER MENU -->
            <nav class="header-menu hidden lg:block">
                {{navigation}}
                <div
                    class="header-nav-account-links flex gap-4 items-center lg:hidden border-t border-[#EBEBEB] mt-10 pt-10">
                    {{#if @member}}
                    <a href="javascript:void(0)" data-members-signout
                        class="px-5 py-2 text-sm font-medium rounded-full bg-black dark:bg-white dark:text-black text-white hover:bg-[#FF7044] transition">
                        Sign Out
                    </a>
                    {{else}}
                    <a href="#/portal/signin" class="inline-flex text-sm text-black">Sign In</a>

                    <a href="#/portal/signup"
                        class="hidden lg:inline-flex items-center px-5 py-2 min-h-11 text-sm font-medium rounded-full bg-black text-white hover:text-white hover:bg-accent-bg transition">
                        Become a Subscriber
                    </a>
                    {{/if}}
                </div>
            </nav>
            <!-- RIGHT SECTION -->
            <div class="flex items-center gap-3 ml-auto">
                <button
                    class="gh-search w-6 h-6 md:w-9.5 md:h-9.5 flex items-center justify-center rounded-full hover:bg-white hover:text-black text-black cursor-pointer"
                    data-ghost-search>{{> "icons/search"}}
                </button>

                <button id="dark-lite-mode"
                    class="relative w-6 h-6 md:w-9.5 md:h-9.5 flex justify-center items-center transition-opacity rounded-full hover:bg-white hover:text-black text-black cursor-pointer">
                    <span id="dark-span" class="absolute transition-opacity will-change-[opacity] duration-300">
                        {{> "icons/dark-mode"}}
                    </span>
                    <span id="light-span" class="transition-opacity will-change-[opacity] duration-300 opacity-0">
                        {{> "icons/light-mode"}}
                    </span>
                </button>

                {{#if @member}}
                <a href="javascript:void(0)" data-members-signout
                    class="px-5 py-2 text-sm font-medium rounded-full bg-black dark:bg-white dark:text-black text-black hover:bg-[#FF7044] transition">
                    Sign Out
                </a>
                {{else}}
                <!-- Sign In -->
                <a href="#/portal/signin" class="hidden lg:block text-sm text-black mx-2.5">Sign In</a>

                <!-- Button -->
                <a href="#/portal/signup"
                    class="hidden lg:inline-flex items-center px-5 py-2 min-h-11 text-sm font-medium rounded-full bg-black text-white hover:text-white hover:bg-accent-bg transition">
                    Become a Subscriber
                </a>
                {{/if}}
                <button class="header-utils-burger w-7 h-4 lg:hidden relative">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                {{!-- <button class="header-nav-close">
                    <svg width="19" height="19" viewBox="0 0 19 19" fill="none">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M17.5686 17.5078C17.2135 17.8628 16.6379 17.8628 16.2829 17.5078L0.854299 2.07922C0.499259 1.72418 0.499259 1.14854 0.854299 0.793503C1.20934 0.438463 1.78497 0.438463 2.14001 0.793503L17.5686 16.2221C17.9236 16.5771 17.9236 17.1527 17.5686 17.5078Z"
                            fill="currentColor"></path>
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M17.5686 0.793667C17.9236 1.14871 17.9236 1.72434 17.5686 2.07938L2.14001 17.5079C1.78497 17.863 1.20933 17.863 0.854294 17.5079C0.499254 17.1529 0.499254 16.5773 0.854294 16.2222L16.2829 0.793667C16.6379 0.438627 17.2135 0.438627 17.5686 0.793667Z"
                            fill="currentColor"></path>
                    </svg>
                </button> --}}
            </div>
        </div>

        <nav class="mobile-header-menu block lg:hidden">
            {{navigation}}
            {{!-- {{> main-navigation}} --}}
            <div
                class="header-nav-account-links flex gap-4 items-center lg:hidden border-t border-[#EBEBEB] mt-10 pt-10">
                {{#if @member}}
                <a href="javascript:void(0)" data-members-signout
                    class="px-5 py-2 text-sm font-medium rounded-full bg-black dark:bg-white dark:text-black text-white hover:bg-[#FF7044] transition">
                    Sign Out
                </a>
                {{else}}
                <!-- Sign In -->
                <a href="#/portal/signin" class="inline-flex text-base lg:text-sm text-black">Sign In</a>

                <!-- Button -->
                <!-- Button -->
                <a href="#/portal/signup"
                    class="hidden lg:inline-flex items-center px-5 py-2 min-h-11 text-sm font-medium rounded-full bg-black text-white hover:text-white hover:bg-accent-bg transition">
                    Become a Subscriber
                </a>
                {{/if}}
            </div>
        </nav>
    </div>
</header>