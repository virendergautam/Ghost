{{!< default}} <!-- Top orange strip -->

    <section class="hero-banner bg-secondary py-14">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div>
                    <h1 class="text-[54px] font-semibold mb-6">Hello 👋, we are exploring fashion, lifestyle and health.
                    </h1>
                    <p class="text-xl max-w-2xl">Get the email newsletter and unlock access to members-only content and
                        updates Shine is a modern classic blog theme for Ghost.</p>
                    <form class="mt-11">
                        <div
                            class="flex items-center max-w-[500px] bg-slate-100 rounded-full border border-gray-200 min-h-[48px] p-[3px]">
                            <input type="email" placeholder="Enter your email"
                                class="flex-1 bg-transparent px-4 text-sm md:text-base text-slate-800 placeholder:text-slate-400 focus:outline-none" />
                            <button type="submit"
                                class="min-h-[48px] px-5 md:px-8 py-2.5 text-base font-medium rounded-full cursor-pointer bg-[#FF7044] text-white">
                                Subscribe
                            </button>
                        </div>
                    </form>
                </div>
                <div class="flex items-center gap-6">
                    <div class="flex-1">
                        <div class="h-[90%] w-full overflow-hidden rounded-2xl">
                            <img src="./assets/images/banner1.jpg" alt="Person drinking coffee by the window"
                                class="h-full w-full object-cover" />
                        </div>
                    </div>
                    <div class="flex-1 flex gap-6 flex-col">
                        <div class="w-full overflow-hidden rounded-2xl">
                            <img src="./assets/images/banner2.jpg" alt="Woman doing yoga at the beach"
