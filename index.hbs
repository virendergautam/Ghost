                        </div>
                        <!-- Overlay -->
                        <div class="absolute inset-0 bg-black/40"></div>
                        <!-- Content -->
                        <div class="absolute inset-0 p-8 text-white flex flex-col justify-between">
                            <div class="card-tags">
                                {{#foreach tags}}
                                <a href="#" class="card-tag">{{name}}</a>
                                {{/foreach}}
                                {{!-- <span class="card-tag">Lifestyle</span>
                                <span class="card-tag">Fashion</span> --}}
                            </div>
                            <div class="">
                                <h1 class="text-4xl font-semibold mb-6">
                                    {{title}}
                                </h1>

                                <p class="text-base max-w-xl mb-4">
                                    {{excerpt}}
                                </p>

                                <!-- Author -->
                                <div class="flex items-center gap-3 text-sm">
                                    <div class="post-card-author-img w-[34px] h-[34px] rounded-full overflow-hidden">
                                        {{!-- <img src="https://randomuser.me/api/portraits/women/32.jpg" />
                                        --}}
                                        <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}" />

                                    </div>
                                    <span>by {{primary_author.name}} / {{date published_at format="MMMM DD,
                                        YYYY"}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/foreach}}
                    {{/get}}
