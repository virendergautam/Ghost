    {{#get "posts" limit="4" filter="featured:true" include="authors,tags"}}
    <section class="blog-posts bg-primary py-10">
        <div class="container mx-auto">
            <h2 class="font-bold text-2xl md:text-[38px] mb-9">Discover Our Featured Posts</h2>

            <div class="blog-posts-wrapper grid gap-6 grid-cols-4">
                {{!-- 🔵 1st Post - Large Left --}}
                {{!-- Index 0 --}}
                {{#foreach posts}}
                {{#if @first}}
                <article class="blog-post-item relative rounded-3xl overflow-hidden col-span-2 row-span-2 group">
                    <a href="{{url}}" class="block w-full h-full">
                        <div class="w-full h-full">
                            <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                                alt="{{title}}" class="transition-transform duration-500 group-hover:scale-105" />
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>

                        <div class="absolute inset-0 z-10 p-4 md:p-6.5 flex flex-col justify-between h-full">

                            {{!-- Tags --}}
                            <div class="flex gap-2 flex-wrap">
                                {{#foreach tags limit="2"}}
                                <span
                                    class="px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">
                                    {{name}}
                                </span>
                                {{/foreach}}
                            </div>

                            <div>
                                <h2 class="text-white text-[22px] md:text-2xl font-semibold mb-5 md:mb-7.5">
                                    {{title}}
                                </h2>

                                <p class="text-white text-sm max-w-xl mb-5 md:mb-7.5">
                                    {{excerpt}}
                                </p>

                                <div class="flex items-center gap-3">
                                    {{#if authors.[0].profile_image}}
                                    <div class="w-9 h-9 rounded-full overflow-hidden">
                                        <img src="{{authors.[0].profile_image}}" alt="{{authors.[0].name}}" />
                                    </div>
                                    {{/if}}
                                    <div class="text-xs text-white/80">
                                        <div>By {{authors.[0].name}}</div>
                                        <div class="opacity-80">{{date format="MMMM DD, YYYY"}}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
                {{/if}}
                {{/foreach}}
                {{!-- 🔵 2nd + 3rd Posts - Top Right --}}
                {{#foreach posts from="2" to="3"}}
                <article class="blog-post-item relative rounded-3xl overflow-hidden group">
                    <a href="{{url}}" class="block w-full h-full">
                        <div class="w-full h-full">
                            <img src="{{feature_image}}" alt="{{title}}"
                                class="transition-transform duration-500 group-hover:scale-105" />
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>
                        <div class="absolute inset-0 z-10 flex flex-col justify-between h-full p-4 md:p-6.5">
                            <div class="flex gap-2 flex-wrap">
                                {{#foreach tags limit="1"}}
                                <span
                                    class="px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">
                                    {{name}}
                                </span>
                                {{/foreach}}
                            </div>

                            <div>
                                <h3 class="text-white text-lg font-semibold mb-5">
                                    {{title}}
                                </h3>

                                <div class="flex items-center gap-3 text-[11px] text-white/80">
                                    {{#if authors.[0].profile_image}}

                                    <div class="w-9 h-9 rounded-full overflow-hidden">
                                        <img src="{{authors.[0].profile_image}}" alt="{{authors.[0].name}}" />
                                    </div>
                                    {{/if}}
                                    <span>By {{authors.[0].name}} / {{date format="MMMM DD, YYYY"}}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
                {{/foreach}}

                {{!-- 🔵 4th Post - Bottom Wide --}}
                {{#foreach posts from="4"}}
                {{#if @last}}
                <article class="blog-post-item relative rounded-3xl overflow-hidden col-span-2 group">
                    <a href="{{url}}" class="block w-full h-full">
                        <div class="w-full h-full">
                            <img src="{{feature_image}}" alt="{{title}}"
                                class="transition-transform duration-500 group-hover:scale-105" />
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>

                        <div class="absolute inset-0 z-10 flex flex-col justify-between h-full p-4 md:p-6.5">
                            <div class="flex">
                                {{#foreach tags limit="1"}}
                                <span
                                    class="px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">
                                    {{name}}
                                </span>
                                {{/foreach}}
                            </div>

                            <div>
                                <h3 class="text-white text-lg sm:text-xl font-semibold mb-5 max-w-2xl">
                                    {{title}}
                                </h3>

                                <div class="flex items-center gap-3 text-[11px] text-white/80">
                                    {{#if authors.[0].profile_image}}

                                    <div class="w-9 h-9 rounded-full overflow-hidden">
                                        <img src="{{authors.[0].profile_image}}" alt="{{authors.[0].name}}" />
                                    </div>
                                    {{/if}}
                                    <span>By {{authors.[0].name}} / {{date format="MMMM DD, YYYY"}}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
                {{/if}}
                {{/foreach}}
            </div>
        </div>
    </section>
    {{/get}}

    <section class="recommended-post bg-secondary-bg text-secondary-text py-10">
        <div class="container mx-auto">
            <div class="recommended-post-header mb-6 md:mb-8">
                <h2 class="text-2xl md:text-4xl font-semibold">Read Our Latest Posts </h2>
            </div>
            <div class="recommended-post-wrapper grid md:grid-cols-4 gap-5">
                {{#foreach posts}}
                {{>"postCard"}}
                {{/foreach}}
            </div>

        </div>
    </section>

    <section class="team-section bg-primary py-10">
        <div class="container mx-auto">
            <div class="section-heading mb-9">
                <h2 class="text-2xl md:text-[38px] font-bold">Meet The Team</h2>
            </div>
            <div class="flex gap-4 sm:gap-6 lg:gap-10 mobile-swipe mobile-column-2">

                {{#get "authors" limit="all"}}
                {{#foreach authors}}
                <a href={{url}} class="group text-center">
                    <div class="border border-gray-200 rounded-full overflow-hidden aspect-square p-[6px]">
                        {{#if profile_image}}
                        <img src="{{profile_image}}" alt="{{name}}" class="rounded-full" />
                        {{else}}
                        <div id="randomColorBox"
                            class="w-full h-full rounded-full overflow-hidden flex justify-center items-center">
                            <span class="font-bold text-2xl sm:text-4xl">
                                {{~#split name separator=" " as |words|~}}
                                {{~#foreach words~}}
                                {{~#split this separator="" as |chars|~}}
                                {{~#foreach chars~}}
                                {{~#if @first~}}{{this}}{{~/if~}}
                                {{~/foreach~}}
                                {{~/split~}}
                                {{~/foreach~}}
                                {{~/split~}}
                            </span>
                        </div>
                        {{/if}}
                    </div>
                    <div class="mt-2 text-base font-semibold">{{name}}</div>
                </a>
                {{/foreach}}
                {{/get}}

            </div>
        </div>
    </section>