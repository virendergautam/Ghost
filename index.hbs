{{!< default}} <section class="hero-banner">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <h1 class="richtext-heading text-[64px] max-w-[1000px] mx-auto">Hello 👋, we are Shine exploring <span
                        class="font-bold"> fashion, lifestyle and health.</span></h1>
                <p class="text-xl max-w-2xl mx-auto">Get the email newsletter and unlock access to members-only content
                    and
                    updates Shine is a modern classic blog theme for Ghost.</p>
                <form class="mt-4">
                    <div
                        class="flex items-center max-w-md bg-slate-50 rounded-full shadow-sm border border-slate-200 overflow-hidden">
                        <input type="email" placeholder="Enter your email"
                            class="flex-1 bg-transparent px-4 py-2.5 text-sm md:text-base text-slate-800 placeholder:text-slate-400 focus:outline-none" />
                        <button type="submit"
                            class="px-5 md:px-6 py-2.5 text-sm font-medium rounded-full bg-blue-600 text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-500">
                            Subscribe
                        </button>
                    </div>
                </form>
            </div>
            <div class="grid grid-cols-2 grid-rows-2 gap-4 h-full">
                <!-- Large image -->
                <div class="col-span-1 row-span-2">
                    <div class="h-full w-full overflow-hidden rounded-2xl">
                        <img src="https://images.unsplash.com/photo-1514996937319-344454492b37?auto=format&fit=crop&w=900&q=80"
                            alt="Person drinking coffee by the window" class="h-full w-full object-cover" />
                    </div>
                </div>

                <!-- Top-right small image -->
                <div>
                    <div class="h-full w-full overflow-hidden rounded-2xl">
                        <img src="https://images.unsplash.com/photo-1517832606294-5df1886e1d52?auto=format&fit=crop&w=900&q=80"
                            alt="Woman doing yoga at the beach" class="h-full w-full object-cover" />
                    </div>
                </div>

                <!-- Bottom-right small image -->
                <div>
                    <div class="h-full w-full overflow-hidden rounded-2xl">
                        <img src="https://images.unsplash.com/photo-1508188239917-0fc5f653cb47?auto=format&fit=crop&w=900&q=80"
                            alt="Woman in sunglasses with a bag" class="h-full w-full object-cover" />
                    </div>
                </div>
            </div>
            </section>
            {{#get "posts" filter="featured:true" limit="1" include="authors,tags"}}
            {{#foreach posts}}
            <section class="featured-blog py-20">
                <div class="container mx-auto">
                    <div class="featured-blog-wrapper relative">
                        <div class="featured-blog-media rounded-2xl overflow-hidden h-[var(--media-height)]">
                            {{!-- <img src="./assets/images/featured-blog.jpg" alt=""> --}}
                            <img src="{{feature_image}}" alt="{{title}}" />
                        </div>
                        <div class="featured-blog-content absolute inset-0 p-8 flex flex-col justify-between">
                            <div class="featured-blog-content-top flex items-center justify-between">
                                <div class="card-tags">
                                    {{#foreach tags}}
                                    <a href="#" class="card-tag">{{name}}</a>
                                    {{/foreach}}
                                    {{!-- <a href="#" class="card-tag">
                                        Lifestyle
                                    </a>
                                    <a href="#" class="card-tag">
                                        Fashion
                                    </a> --}}
                                </div>
                                <div class="featured-card-meta flex gap-x-4 items-center">
                                    <div class="post-card-author flex gap-x-2 items-center">
                                        <a href="#"
                                            class="post-card-author-img-link block w-[34px] h-[34px] rounded-full overflow-hidden">
                                            {{!-- <img src="./assets/images/featured-blog.jpg" alt=""> --}}
                                            <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}" />
                                        </a>
                                        <div class="post-card-author-name-wrapper text-white">
                                            <span class="post-card-author-name">by {{primary_author.name}} /</span>
                                            <span class="post-card-publish-date">{{date published_at format="MMMM
                                                DD, YYYY"}}
                                            </span>
                                        </div>
                                    </div>
                                    <div
                                        class="post-card-time text-black bg-white rounded-full text-sm py-[6px] px-[10px]">
                                        {{reading_time}} min Read
                                    </div>
                                </div>
                            </div>
                            <div class="featured-blog-content-bottom max-w-[556px] flex items-start flex-col gap-y-6">
                                <h2 class="text-5xl font-semibold text-white">{{title}}</h2>
                                <p class="text-base text-white">{{excerpt}}</p>
                                <a href="{{url}}"
                                    class="bg-black text-white px-6 py-3 rounded-full font-medium hover:bg-gray-200 transition">
                                    Read More
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            {{/foreach}}
            {{/get}}
