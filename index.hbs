<section class="blog-posts py-20">
    <div class="container mx-auto">
        <h2 class="font-bold text-[38px] mb-9">Discover Our Featured Posts</h2>

        <div class="grid gap-6 lg:grid-cols-4 grid-rows-2">
            
            {{!-- 🔵 1st Post - Large Left --}}
            {{!-- Index 0 --}}
            {{#foreach posts}}
                {{#if @first}}
                <article class="relative rounded-3xl overflow-hidden lg:col-span-2 lg:row-span-2 group auto-rows-[minmax(0,360px)]">
                    <a href="{{url}}">
                        <img src="{{feature_image}}" alt="{{title}}" class="transition-transform duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>

                        <div class="absolute inset-0 z-10 p-6.5 flex flex-col justify-between h-full">

                            {{!-- Tags --}}
                            <div class="flex gap-2 flex-wrap">
                                {{#foreach tags limit="2"}}
                                    <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">
                                        {{name}}
                                    </span>
                                {{/foreach}}
                            </div>

                            <div>
                                <h2 class="text-white text-2xl sm:text-3xl font-semibold mb-7.5">
                                    {{title}}
                                </h2>

                                <p class="text-white text-sm max-w-xl mb-7.5">
                                    {{excerpt}}
                                </p>

                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full overflow-hidden">
                                        <img src="{{authors.[0].profile_image}}" alt="{{authors.[0].name}}" />
                                    </div>
                                    <div class="text-xs text-white/80">
                                        <div>By {{authors.[0].name}}</div>
                                        <div class="opacity-80">{{date format="MMMM DD, YYYY"}}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
                {{/if}}
            {{/foreach}}

            {{!-- 🔵 2nd + 3rd Posts - Top Right --}}
            <div class="lg:col-span-2 grid gap-6 md:grid-cols-2 row-span-2">

                {{#foreach posts from="2" to="3"}}
                <article class="relative rounded-3xl overflow-hidden bg-gray-900 group">
                    <a href="{{url}}">
                        <img src="{{feature_image}}" alt="{{title}}" class="transition-transform duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>

                        <div class="absolute inset-0 z-10 flex flex-col justify-between h-full p-6.5">
                            <div class="flex gap-2 flex-wrap">
                                {{#foreach tags limit="1"}}
                                <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">
                                    {{name}}
                                </span>
                                {{/foreach}}
                            </div>

                            <div>
                                <h3 class="text-white text-lg font-semibold mb-5">
                                    {{title}}
                                </h3>

                                <div class="flex items-center gap-3 text-[11px] text-white/80">
                                    <div class="w-9 h-9 rounded-full overflow-hidden">
                                        <img src="{{authors.[0].profile_image}}" alt="{{authors.[0].name}}" />
                                    </div>
                                    <span>By {{authors.[0].name}} / {{date format="MMMM DD, YYYY"}}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
                {{/foreach}}
           

            {{!-- 🔵 4th Post - Bottom Wide --}}
            {{#foreach posts}}
                {{#if @last}}
                <article class="relative rounded-3xl overflow-hidden bg-gray-900 group md:col-span-2 min-h-[220px]">
                    <a href="{{url}}">
                        <img src="{{feature_image}}" alt="{{title}}" class="transition-transform duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>

                        <div class="absolute inset-0 z-10 flex flex-col justify-between h-full p-6.5">
                            <div class="flex">
                                {{#foreach tags limit="1"}}
                                <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">
                                    {{name}}
                                </span>
                                {{/foreach}}
                            </div>

                            <div>
                                <h3 class="text-white text-lg sm:text-xl font-semibold mb-5 max-w-2xl">
                                    {{title}}
                                </h3>

                                <div class="flex items-center gap-3 text-[11px] text-white/80">
                                    <div class="w-9 h-9 rounded-full overflow-hidden">
                                        <img src="{{authors.[0].profile_image}}" alt="{{authors.[0].name}}" />
                                    </div>
                                    <span>By {{authors.[0].name}} / {{date format="MMMM DD, YYYY"}}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </article>
                {{/if}}
            {{/foreach}}
             </div>

        </div>
    </div>
