{{!< default}} <!-- Top orange strip -->

    <section class="hero-banner relative py-17.5 min-h-dvh flex items-end bg-accent-bg">
        <div class="background-image absolute inset-0">
            {{#if @site.cover_image}}
            <img class="site-header-cover" srcset="{{img_url @site.cover_image size=" s"}} 300w, {{img_url
                @site.cover_image size="m" }} 600w, {{img_url @site.cover_image size="l" }} 1000w, {{img_url
                @site.cover_image size="xl" }} 2000w" sizes="100vw" src="{{img_url @site.cover_image size=" xl"}}"
                alt="{{@site.title}}" />
            {{/if}}
        </div>
        <div class="hero-content relative w-full px-4 flex justify-center">
            <div class="max-w-[740px] text-center text-white">
                <h1 class="text-[28px] md:text-[34px] lg:text-[54px] font-semibold mb-4 md:mb-6">
                    {{@custom.hero_heading}}
                </h1>
                <p class="text-base max-w-xl m-auto">{{@custom.hero_subheading}}</p>
                <form class="mt-6 md:mt-9">
                    <div
                        class="grid grid-cols-(--my-grid-cols) max-w-[500px] mx-auto bg-white/20 backdrop-blur-2xl rounded-full border border-white/20 min-h-[48px] p-1.5">
                        <input type="email" placeholder="Enter your email"
                            class="min-w-0 flex-1 bg-transparent px-4 text-sm text-white placeholder:text-white focus:outline-none" />
                        <button type="submit"
                            class="bg-black min-h-[42px] px-5 md:px-6.5 py-2.5 text-sm font-medium rounded-full cursor-pointer text-white">
                            Subscribe
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

{{>"tagSection"}}
{{>"featuredArticleSection"}}

    <section>
        <!-- Wrapper (light gray section like screenshot) -->
        <section class="bg-secondary-bg pt-6 pb-12">
            <div class="container mx-auto">
                <!-- Cards row -->
                <div class="grid gap-2.5 md:grid-cols-3">
                    {{#get "posts" limit="3" include="tags,authors"}}
                    {{#foreach posts}}
                    <!-- Card 1 -->
                    <article class="flex gap-4 rounded-[20px] border border-[#dddddd] bg-white p-5">
                        <div class="rounded-[20px] overflow-hidden w-[200px]">
                            <img class="h-20 w-28 rounded-xl object-cover"
                                src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                                alt="{{title}}" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500">
                                {{#if primary_tag}}
                                <span class="rounded-full bg-green-100 px-2 py-1 font-medium text-green-800">
                                    {{primary_tag.name}}
                                </span>
                                {{/if}}
                                <span>{{date published_at format="MMM DD, YYYY"}}</span>
                            </div>

                            <h3 class="mt-5 text-base font-bold"> <a href="{{url}}" class="hover:underline">
                                    {{title}}
                                </a></h3>
                            <p class="mt-5 text-sm">
                                {{excerpt words="18"}}
                            </p>
                        </div>
                    </article>
                    {{/foreach}}
                    {{/get}}
                </div>
            </div>
        </section>

    </section>

    <section class="trust-icons bg-primary py-10">
        {{>"static-section"}}
    </section>

    <section class="h-screen w-full overflow-hidden">

        <!-- LEFT LIST -->
        <aside class="w-[380px] bg-black/40 backdrop-blur-md p-4 space-y-2 z-10">
            <!-- Item -->
            <div class="group flex gap-3 rounded-xl p-3 cursor-pointer hover:bg-white/10 transition"
                data-image="https://images.unsplash.com/photo-1501785888041-af3ef285b470">
                <img class="h-14 w-14 rounded-lg object-cover"
                    src="https://images.unsplash.com/photo-1501785888041-af3ef285b470" />
                <div>
                    <p class="text-xs text-white/60">Nov 14, 2025 · Breana Fraley</p>
                    <h4 class="text-sm font-semibold">
                        From underground gigs to stadium rock anthems
                    </h4>
                </div>
            </div>

            <div class="group flex gap-3 rounded-xl p-3 cursor-pointer hover:bg-white/10 transition"
                data-image="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee">
                <img class="h-14 w-14 rounded-lg object-cover"
                    src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee" />
                <div>
                    <p class="text-xs text-white/60">Nov 14, 2025 · Breana Fraley</p>
                    <h4 class="text-sm font-semibold">
                        Moments That Make You Feel Alive While Travelling
                    </h4>
                </div>
            </div>

            <div class="group flex gap-3 rounded-xl p-3 cursor-pointer hover:bg-white/10 transition"
                data-image="https://images.unsplash.com/photo-1507525428034-b723cf961d3e">
                <img class="h-14 w-14 rounded-lg object-cover"
                    src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e" />
                <div>
                    <p class="text-xs text-white/60">Nov 14, 2025 · Breana Fraley</p>
                    <h4 class="text-sm font-semibold">
                        Diving into Nature’s Blue Heart Underwater Journeys
                    </h4>
                </div>
            </div>
        </aside>

        <!-- RIGHT BACKGROUND -->
        <div class="">
            <div class="">
                <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470" alt="">
            </div>

            <!-- Overlay -->
            <div class="absolute inset-0 bg-black/30"></div>
        </div>

    </section>

    <section class="recommended-post bg-secondary-bg text-secondary-text py-10">
        <div class="container mx-auto">
            <div class="recommended-post-header mb-6 md:mb-8">
                <h2 class="text-2xl md:text-4xl font-semibold">Read Our Latest Posts </h2>
            </div>
            <div class="recommended-post-wrapper grid md:grid-cols-4 gap-5">
                {{#foreach posts}}
                {{>"postCard"}}
                {{/foreach}}
            </div>

        </div>
    </section>

    <section class="team-section bg-primary py-10">
        <div class="container mx-auto">
            <div class="section-heading mb-9">
                <h2 class="text-2xl md:text-[38px] font-bold">Meet The Team</h2>
            </div>
            <div
                class="grid md:items-start md:grid-cols-6 lg:grid-cols-9 md:items-center md:justify-center gap-4 sm:gap-6 lg:gap-10 mobile-swipe mobile-column-2">

                {{#get "authors" limit="all"}}
                {{#foreach authors}}
                <a href={{url}} class="group text-center">
                    <div class="border border-gray-200 rounded-full overflow-hidden aspect-square p-[6px]">
                        {{#if profile_image}}
                        <img src="{{profile_image}}" alt="{{name}}" class="rounded-full" />
                        {{else}}
                        <div id="randomColorBox"
                            class="w-full h-full rounded-full overflow-hidden flex justify-center items-center">
                            <span class="font-bold text-2xl sm:text-4xl">
                                {{~#split name separator=" " as |words|~}}
                                {{~#foreach words~}}
                                {{~#split this separator="" as |chars|~}}
                                {{~#foreach chars~}}
                                {{~#if @first~}}{{this}}{{~/if~}}
                                {{~/foreach~}}
                                {{~/split~}}
                                {{~/foreach~}}
                                {{~/split~}}
                            </span>
                        </div>
                        {{/if}}
                    </div>
                    <div class="mt-2 text-base font-semibold">{{name}}</div>
                </a>
                {{/foreach}}
                {{/get}}

            </div>
        </div>
    </section>