{{!< default}} <!-- Top orange strip -->

    <section class="hero-banner relative py-17.5 min-h-dvh flex items-end bg-accent-bg">
        <div class="background-image absolute inset-0">
            {{#if @site.cover_image}}
            <img class="site-header-cover" srcset="{{img_url @site.cover_image size=" s"}} 300w, {{img_url
                @site.cover_image size="m" }} 600w, {{img_url @site.cover_image size="l" }} 1000w, {{img_url
                @site.cover_image size="xl" }} 2000w" sizes="100vw" src="{{img_url @site.cover_image size=" xl"}}"
                alt="{{@site.title}}" />
            {{/if}}
        </div>
        <div class="hero-content relative w-full px-4 flex justify-center">
            <div class="max-w-[740px] text-center text-white">
                <h1 class="text-[28px] md:text-[34px] lg:text-[54px] font-semibold mb-4 md:mb-6">
                    {{@custom.hero_heading}}
                </h1>
                <p class="text-base max-w-xl m-auto">{{@custom.hero_subheading}}</p>
                <form class="mt-6 md:mt-9">
                    <div
                        class="grid grid-cols-(--my-grid-cols) max-w-[500px] mx-auto bg-white/20 backdrop-blur-2xl rounded-full border border-white/20 min-h-[48px] p-1.5">
                        <input type="email" placeholder="Enter your email"
                            class="min-w-0 flex-1 bg-transparent px-4 text-sm text-white placeholder:text-white focus:outline-none" />
                        <button type="submit"
                            class="bg-black min-h-[42px] px-5 md:px-6.5 py-2.5 text-sm font-medium rounded-full cursor-pointer text-white">
                            Subscribe
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <section class="explore-tags py-10">
        <div class="container mx-auto">
            <div class="explore-tags-wrapper">
                <div class="explore-tags-header mb-12.5 max-w-[676px] m-auto text-center">
                    <div
                        class="inline-flex items-center justify-center rounded-full border border-[#DDDDDD] bg-[#F0EFEF] px-5 py-2 text-xs mb-7.5">
                        EXPLORE BY TOPICS
                    </div>
                    <h2 class="text-2xl md:text-5xl font-semibold">Uncover the Wonders of the Natural World</h2>
                </div>
                <div class="grid grid-cols-4 gap-7">
                    {{#get "tags" filter="visibility:public"  limit="4"  include="count.posts"}} {{#foreach tags}}
                    <a href="/tag/{{slug}}/" class="relative block rounded-2xl overflow-hidden group explore-tags-item">
                        <div class="aspect-square">
                            <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                                alt="{{name}}"
                                class="object-cover transition-transform duration-500 group-hover:scale-105" />
                        </div>
                        <div class="absolute inset-0 flex justify-between items-end p-4.5">
                            <h3 class="font-medium text-sm md:text-base break-all bg-white px-6 py-2.5 rounded-3xl">{{name}}</h3>
                            <p class="text-xs md:text-base text-white bg-white/20 backdrop-blur-xl px-5 py-2.5 rounded-3xl">
                                {{plural count.posts empty="0 Articles" singular="1 Article" plural="% Articles"}}
                            </p>
                        </div>
                    </a>
                    {{/foreach}} {{/get}}
                </div>
            </div>
        </div>
    </section>


    {{#get "posts" filter="featured:true" limit="1" include="authors,tags"}}
    {{#foreach posts}}
    <section class="featured-blog py-10">
        <div class="container mx-auto">
            <div class="featured-blog-wrapper relative">
                <div class="featured-blog-media rounded-2xl overflow-hidden h-[var(--media-height)]">
                    {{!-- <img src="./assets/images/featured-blog.jpg" alt="{{title}}" /> --}}
                    <img src="{{#if feature_image}}{{feature_image}}{{else}}/assets/images/no-image.png{{/if}}"
                        alt="{{title}}" />
                </div>
                <div class="featured-blog-content absolute inset-0 p-4 md:p-8 flex flex-col justify-between">
                    <div class="featured-blog-content-top flex flex-wrap gap-y-3 items-center justify-between">
                        <div class="card-tags">
                            {{#foreach tags}}
                            <a href="#"
                                class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">{{name}}</a>
                            {{/foreach}}
                            {{!-- <a href="#"
                                class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">Lifestyle</a>
                            <a href="#"
                                class="card-tag px-3 py-1 text-xs font-medium rounded-full bg-white/30 text-white backdrop-blur-sm">Fashion</a>
                            --}}
                        </div>
                        <div class="featured-card-meta flex flex-wrap gap-y-3 gap-x-4 items-center">
                            <div class="post-card-author flex gap-x-2 items-center">
                                {{#if primary_author.profile_image}}

                                <a href="/author/{{primary_author.name}}/"
                                    class="post-card-author-img-link block w-[34px] h-[34px] rounded-full overflow-hidden">
                                    {{!-- <img src="./assets/images/team9.jpg" alt="{{primary_author.name}}" /> --}}
                                    <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}" />
                                </a>
                                {{/if}}
                                <div class="post-card-author-name-wrapper text-white text-xs">
                                    <span class="post-card-author-name">by {{primary_author.name}} /</span>
                                    <span class="post-card-publish-date">{{date published_at format="MMMM
                                        DD, YYYY"}}
                                    </span>
                                </div>
                            </div>
                            <div
                                class="post-card-time font-medium rounded-full bg-white/30 text-white backdrop-blur-sm text-xs py-[6px] px-[10px]">
                                {{reading_time}} min Read
                            </div>
                        </div>
                    </div>
                    <div class="featured-blog-content-bottom max-w-[660px] flex items-start flex-col gap-y-6">
                        <h2 class="text-2xl md:text-4xl font-semibold text-white">{{title}}</h2>
                        <p class="text-sm text-white">{{excerpt}}</p>
                        <a href="{{url}}"
                            class="bg-white text-black px-6 py-3 rounded-full font-medium hover:bg-gray-200 transition">
                            Read More
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    {{/foreach}}
    {{/get}}

    <section class="trust-icons bg-primary py-10">
        {{>"static-section"}}
    </section>

