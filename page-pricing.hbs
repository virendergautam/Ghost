{{!< default}}
{{#post}}
<main class="bg-white">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">

    <div class="text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-medium text-gray-700">
        • Pricing
      </span>

      <h1 class="mt-6 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        {{title}}
      </h1>
{{content}}
      {{#if custom_excerpt}}
        <p class="mx-auto mt-3 max-w-2xl text-sm text-gray-600 sm:text-base">
          {{custom_excerpt}}
        </p>
      {{/if}}

      <div class="mt-8 flex justify-center">
        <div class="inline-flex rounded-full border border-gray-200 bg-white p-1 shadow-sm">
          <button type="button" class="js-billing-toggle rounded-full px-4 py-2 text-sm font-medium" data-billing="monthly">Monthly</button>
          <button type="button" class="js-billing-toggle rounded-full px-4 py-2 text-sm font-medium" data-billing="yearly">Yearly</button>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">

      {{#match @site.url "https://nonnutritiously-uncensured-jona.ngrok-free.de"}}

        {{> "pricing-card-demo"
            icon="⭐"
            name="Free"
            desc="For getting started"
            monthly="₹0"
            yearly="₹0"
            btn="Get started"
        }}

        {{> "pricing-card-demo"
            icon="⭐"
            name="Premium"
            desc="For regular readers"
            monthly="₹499"
            yearly="₹4,999"
            btn="Join now"
        }}

        {{> "pricing-card-demo"
            icon="⭐"
            name="Platinum"
            desc="For teams & businesses"
            monthly="Custom"
            yearly="Custom"
            btn="Contact sales"
        }}

      {{else}}

        {{#get "tiers" include="monthly_price,yearly_price,benefits" limit="all"}}
        {{log tiers "Fetched membership tiers for pricing page"}}
          {{#if tiers}}
            {{#foreach tiers}}
              {{> "pricing-card"}}
            {{/foreach}}
          {{else}}
            <div class="col-span-full text-center text-sm text-gray-600">
              No membership tiers found.
            </div>
          {{/if}}
        {{/get}}

      {{/match}}

    </div>

    {{#if content}}
      <div class="prose mx-auto mt-16 max-w-3xl">
        {{content}}
      </div>
    {{/if}}

  </section>

  <script>
    (function () {
      const toggles = Array.from(document.querySelectorAll(".js-billing-toggle"));

      function setBilling(mode) {
        toggles.forEach(btn => {
          const active = btn.dataset.billing === mode;
          btn.classList.toggle("bg-gray-900", active);
          btn.classList.toggle("text-white", active);
          btn.classList.toggle("text-gray-700", !active);
          btn.classList.toggle("hover:bg-gray-100", !active);
        });

        document.querySelectorAll("[data-plan]").forEach(card => {
          const m = card.getAttribute("data-monthly");
          const y = card.getAttribute("data-yearly");
          const priceEl = card.querySelector(".js-price");
          const suffixEl = card.querySelector(".js-suffix");
          if (!priceEl) return;

          if (mode === "yearly" && y) {
            priceEl.textContent = y;
            if (suffixEl) suffixEl.textContent = card.getAttribute("data-yearly-suffix") || "/ per year";
          } else {
            priceEl.textContent = m || y || "0";
            if (suffixEl) suffixEl.textContent = (m ? (card.getAttribute("data-monthly-suffix") || "/ per month")
              : (y ? (card.getAttribute("data-yearly-suffix") || "/ per year") : ""));
          }
        });
      }

      setBilling("monthly");
      toggles.forEach(btn => btn.addEventListener("click", () => setBilling(btn.dataset.billing)));
    })();
  </script>
</main>
{{/post}}