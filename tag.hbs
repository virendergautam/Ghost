{{!< default}} {{#tag}} <div class="container mx-auto">
    {{!-- Tag Cover Image --}}
    <div class="py-15">
        {{#if feature_image}}
        <div class="w-41 h-41 mx-auto overflow-hidden rounded-2xl">
            <img src="{{feature_image}}" alt="{{name}}" class="">
        </div>
        {{/if}}

        {{!-- Tag Header --}}
        <header class="max-w-4xl mx-auto text-center mt-6">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">
                {{name}}
            </h1>

            <div class="text-xs bg-secondary border border-[#EBEBEB] rounded-3xl py-[6px] px-[20px] inline-flex">15
                Article</div>

            {{#if description}}
            <p class="text-gray-600 text-lg mt-6 mb-2">
                {{description}}
            </p>
            {{/if}}
        </header>
    </div>
    </div>
    {{/tag}}

    {{!-- Posts Grid --}}
    <section class="bg-secondary py-12.5">
        <div class="container mx-auto">
            <div class="flex flex-wrap gap-5 items-center mb-12">
                <div class="shrink-0 text-xs uppercase font-semibold">
                    <h2>More Topics:</h2>
                </div>
                <div class="flex flex-wrap gap-2">
                    {{#get "tags" filter="slug:-{{tag.slug}}" limit ="all"}}
                    {{#foreach tags}}
                      <a href={{url}} class="py-2.5 px-5 border border-[#EBEBEB] rounded-full text-sm bg-white">
                        {{name}}
                    </a>
                    {{/foreach}}
                    {{/get}}
                    {{!-- <a href="#" class="py-2.5 px-5 border border-[#EBEBEB] rounded-full text-sm bg-white">
                        Travel Adventure
                    </a>
                    <a href="#" class="py-2.5 px-5 border border-[#EBEBEB] rounded-full text-sm bg-white">
                        Tech Lifestyle Gear
                    </a>
                    <a href="#" class="py-2.5 px-5 border border-[#EBEBEB] rounded-full text-sm bg-white">
                        Style & Essential
                    </a>
                    <a href="#" class="py-2.5 px-5 border border-[#EBEBEB] rounded-full text-sm bg-white">
                        Office Essential Hub
                    </a>
                    <a href="#" class="py-2.5 px-5 border border-[#EBEBEB] rounded-full text-sm bg-white">
                        Runway Highlights
                    </a> --}}
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-y-4 md:gap-y-12.5 gap-x-4.5">
                {{#foreach posts}}
                {{!-- <article
                    class="bg-white shadow-md rounded-xl overflow-hidden hover:shadow-xl transition shadow-gray-200">
                    <a href="{{url}}">
                        {{#if feature_image}}
                        <img src="{{feature_image}}" alt="{{title}}" class="w-full h-48 object-cover">
                        {{/if}}

                        <div class="p-5">
                            <h2 class="text-xl font-semibold mb-3 hover:text-blue-600">
                                {{title}}
                            </h2>

                            <p class="text-gray-600 text-sm">
                                {{excerpt}}
                            </p>
                        </div>
                    </a>
                </article> --}}
                {{> "postCard"}}
                {{/foreach}}
            </div>
        </div>
    </section>

    {{!-- Pagination --}}
    <div class="max-w-6xl mx-auto px-4 mt-12 mb-20">
        {{pagination}}
    </div>