{
  "name": "shineghost",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  },
  "description": "",
  "main": "gulpfile.js",
  "dependencies": {
    "baseline-browser-mapping": "^2.8.29",
    "browserslist": "^4.28.0",
    "caniuse-lite": "^1.0.30001756",
    "electron-to-chromium": "^1.5.258",
    "escalade": "^3.2.0",
    "fraction.js": "^5.3.4",
    "nanoid": "^3.3.11",
    "node-releases": "^2.0.27",
    "normalize-range": "^0.1.2",
    "picocolors": "^1.1.1",
    "postcss-value-parser": "^4.2.0",
    "source-map-js": "^1.2.1",
    "update-browserslist-db": "^1.1.4"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --watch",
    "build": "npx tailwindcss -i ./assets/css/main.css -o ./assets/built/main.css --minify"
  },
  "keywords": [],
  "author": {
    "name": "virender",
    "email": "virender@yopmail.com"
  },
  "license": "ISC",
  "config": {
    "custom": {
      "header_layout": {
        "type": "select",
        "options": [
          "always",
          "animated",
          "none"
        ],
        "default": "Stacked"
      },
      "homepage_layout": {
        "type": "select",
        "options": [
          "Homepage-1",
          "Homepage-2"
        ],
        "default": "Homepage-1",
        "group": "homepage"
      },
      "hero_heading": {
        "type": "text",
        "default": "Hello 👋, we are exploring fashion, lifestyle and health.",
        "group": "homepage"
      },
      "hero_subheading": {
        "type": "text",
        "default": "Get the email newsletter and unlock access to members-only content and updates Shine is a modern classic blog theme for Ghost.",
        "group": "homepage"
      },
     "meet_the_team_section": {
        "type": "boolean",
        "default": true,
        "group": "homepage"
      },

      "color_scheme": {
        "type": "select",
        "options": [
          "Default",
          "Dark Trail",
          "Natural Escape",
          "Urban Mist",
          "Aqua Marine",
          "Desert Bloom",
          "Mocha Dark",
          "Dark Amethyst"
        ],
        "default": "Natural Escape"
      },
      "contact_form_endpoint": {
        "type": "text",
        "default": ""
      },
      "show_subscribe_newsletter_section": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "show_related_post": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "post_type": {
        "type": "select",
        "options": [
          "Default",
        "Full width image",
        "Image overlay ",
        "Table of contents",
        "split view"
        ],
        "default": "Default",
        "group": "post"
      }
    }
  }
}
