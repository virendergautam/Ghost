{{!< default}}
{{#post}}
<section class="contact-page mt-6">
  {{content}}
  <!-- Contact Form Section (Tailwind) -->
<section class="bg-primary-bg">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <div class="rounded-3xl bg-white p-8 sm:p-10">
      <h2 class="text-4xl font-extrabold tracking-tight text-zinc-900">
        Let’s get In Touch
      </h2>
      <!-- IMPORTANT: action + method -->
      <form
        class="mt-10 space-y-6"
        action="{{@custom.contact_form_endpoint}}"
        method="POST"
      >
        <!-- 2-column grid -->
        <div class="grid gap-6 sm:grid-cols-2">
          <!-- Full Name -->
          <div>
            <label class="text-sm font-semibold text-zinc-900">
              Full Name<span class="text-zinc-900">*</span>
            </label>
            <input
              type="text"
              name="name"
              required
              placeholder="Your full name"
              class="mt-3 w-full rounded-xl bg-zinc-100 px-5 py-4 text-sm text-zinc-900 placeholder:text-zinc-500 outline-none ring-1 ring-transparent focus:ring-zinc-300"
            />
          </div>

          <!-- Email -->
          <div>
            <label class="text-sm font-semibold text-zinc-900">
              Email<span class="text-zinc-900">*</span>
            </label>
            <input
              type="email"
              name="email"
              required
              placeholder="your@email.com"
              class="mt-3 w-full rounded-xl bg-zinc-100 px-5 py-4 text-sm text-zinc-900 placeholder:text-zinc-500 outline-none ring-1 ring-transparent focus:ring-zinc-300"
            />
          </div>

          <!-- Phone -->
          {{!-- <div>
            <label class="text-sm font-semibold text-zinc-900">
              Phone Number<span class="text-zinc-900">*</span>
            </label>
            <input
              type="tel"
              name="phone"
              required
              placeholder="+91 98765 43210"
              class="mt-3 w-full rounded-xl bg-zinc-100 px-5 py-4 text-sm text-zinc-900 placeholder:text-zinc-500 outline-none ring-1 ring-transparent focus:ring-zinc-300"
            />
          </div> --}}

          <!-- Subject -->
          <div>
            <label class="text-sm font-semibold text-zinc-900">
              Subject<span class="text-zinc-900">*</span>
            </label>
            <input
              type="text"
              name="subject"
              required
              placeholder="Subject"
              class="mt-3 w-full rounded-xl bg-zinc-100 px-5 py-4 text-sm text-zinc-900 placeholder:text-zinc-500 outline-none ring-1 ring-transparent focus:ring-zinc-300"
            />
          </div>
        </div>

        <!-- Message -->
        <div>
          <label class="text-sm font-semibold text-zinc-900">
            Message<span class="text-zinc-900">*</span>
          </label>
          <textarea
            name="message"
            rows="8"
            required
            placeholder="Enter your message here"
            class="mt-3 w-full resize-none rounded-2xl bg-zinc-100 px-5 py-4 text-sm text-zinc-900 placeholder:text-zinc-500 outline-none ring-1 ring-transparent focus:ring-zinc-300"
          ></textarea>
        </div>

        <!-- Button -->
        <div class="pt-2">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-full bg-black px-8 py-4 text-sm font-semibold text-white shadow-sm hover:bg-black/90 transition"
          >
            Send Message
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

</section>
{{/post}}
