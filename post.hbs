            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {{#foreach posts}}
                {{>"postCard"}}
                {{/foreach}}
            </div>
            {{/get}}
            {{/if}}
        </section>


        {{#if tags}}
        {{#foreach tags limit="1"}}
        <section class="mt-12">
            <h3 class="text-2xl font-bold mb-6">Related Posts</h3>

            {{#get "posts"
            limit="all"
            include="tags,authors"
            filter="tag:{{slug}}+id:-{{../id}}"
            as |related|
            }}

            {{#if related}}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {{#foreach related}}
                {{>"postCard"}}
                {{/foreach}}
            </div>
            {{else}}
            <p class="text-gray-500">No related posts found.</p>
            {{/if}}

            {{/get}}

        </section>
        {{/foreach}}
        {{/if}}
        <section class="mt-12">
            <h3 class="text-2xl font-bold mb-6">Related Posts</h3>
            {{#get "posts" filter="authors:{{primary_author.slug}}+id:-{{id}}" limit="all"}}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {{#foreach posts}}
                {{>"postCard"}}
                {{/foreach}}
            </div>
        </section>

        {{/get}}
{{/if}}
        {{!-- related post end --}}
    </div>

    </div>
    {{/post}}