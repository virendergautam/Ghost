                </div>


            </div>
            {{#if @custom.show_subscribe_newsletter_section}}

            <div class="max-w-2xl mx-auto bg-secondary rounded-3xl p-6 md:p-10 text-center mt-12.5">
                <h6 class="text-xl font-bold">
                    Subscribe to our newsletter
                </h6>
                <p class="mt-2 text-sm sm:text-base">
                    Join our newsletter to stay up to date on features and releases.
                </p>
                <form class="mt-6 w-full flex items-center justify-center">
                    <div
                        class="flex w-full max-w-md bg-white border border-[#EBEBEB] rounded-full overflow-hidden p-[3px] h-12.5">
                        <input type="email" placeholder="Enter Your email"
                            class="min-w-0 flex-1 px-4 py-2.5 text-base outline-none" />
                        <button type="submit"
                            class="px-6 py-2.5 bg-[#FF7044] hover:bg-[#FF7044] text-white text-sm font-semibold rounded-full transition">
                            Subscribe
                        </button>
                    </div>
                </form>
            </div>
            {{/if}}
        </div>
    </div>
    </div>

    {{!-- related post start --}}
    {{#if @custom.show_related_post}}
    <section class="py-10 bg-secondary">
        <div class="container mx-auto">
        <h3 class="text-[38px] font-bold mb-8">Related Posts</h3>
        {{#get "posts" filter="authors:{{primary_author.slug}}+id:-{{id}}" limit="all"}}
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4.5">
            {{#foreach posts}}
            {{>"postCard"}}
            {{/foreach}}
        </div>
        </div>
        
    </section>

    {{/get}}
    {{/if}}
    {{!-- related post end --}}
    {{/post}}