{{!< default}} {{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}
    {{#post}} <div class="container mx-auto">
    <!-- Header part -->
    <div class="max-w-5xl mx-auto pt-20 pb-10 text-center">

        <!-- Tags -->
        <div class="flex flex-wrap justify-center gap-2 mb-6">

            {{#foreach tags}}
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-[#F1F1F2]">
                {{name}}
            </span>
            {{/foreach}}
        </div>

        <!-- Title -->
        <h1 class="sm:text-3xl md:text-4xl lg:text-[54px] font-bold mb-10">
            {{!-- The Mind and Body Are Not Separate:
            What Affects One --}}
            {{title}}
        </h1>

        <!-- Excerpt -->
        <p class="text-base mb-10">
            {{excerpt}}
        </p>

        <!-- Divider -->
        <div class="border-t border-[#EBEBEB] my-8"></div>

        <!-- Author -->
        <div class="flex items-center justify-center gap-3 text-xs">
            <div class="w-9.5 h-9.5 rounded-full overflow-hidden">
                <img src={{primary_author.profile_image}} alt={{title}} />
            </div>
            <span>
                by <span class="font-medium">{{primary_author.name}}</span>
                &nbsp;•&nbsp; {{date published_at format="DD MMM YYYY"}} &nbsp;/&nbsp; {{reading_time}} min read
            </span>
        </div>

    </div>

    <!-- image part -->
    <div class="rounded-3xl overflow-hidden">

        {{#if feature_image}}
        <img src="{{feature_image}}" alt="{{slug}}">
        {{else}}
        <img src="/assets/images/no-image.png" alt="No Image">
        {{/if}}
    </div>

    <!-- Content part -->
    <div class="max-w-5xl mx-auto p-6 sm:p-10">
        {{content}}

        <div
            class="mt-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs border-b border-[#EBEBEB] pb-7.5">

