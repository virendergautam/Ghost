{{!< default}} {{#post}} <main class="bg-white">
  <section class="px-4 py-30 bg-secondary-bg">
    <div class="mx-auto max-w-[1266px]">
      <div class="text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-medium text-gray-700">
          • Our plans
        </span>

        <h1 class="mt-6 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          {{title}}
        </h1>

        {{#if custom_excerpt}}
        <p class="mx-auto mt-3 max-w-2xl text-sm text-gray-600 sm:text-base">
          {{custom_excerpt}}
        </p>
        {{/if}}

        <div class="mt-8 flex justify-center">
          <div class="inline-flex rounded-full border border-[#EBEBEB] bg-white p-1 ">
            <button type="button" class="js-billing-toggle rounded-full px-4 py-2 text-sm cursor-pointer"
              data-billing="monthly">Monthly</button>
            <button type="button" class="js-billing-toggle rounded-full px-4 py-2 text-sm cursor-pointer"
              data-billing="yearly">Yearly</button>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">

        {{#match @site.url "http://localhost:2368"}}

        {{> "pricing-card-demo"
        icon="⭐"
        name="Free"
        desc="For getting started"
        monthly="$0"
        yearly="$0"
        btn="Get started"
        }}

        {{> "pricing-card-demo"
        icon="⭐"
        name="Premium"
        desc="Full Access to Premium Content"
        monthly="$5"
        yearly="$49"
        btn="Join now"
        }}

        {{> "pricing-card-demo"
        icon="⭐"
        name="Platinum"
        desc="Access to all premium content and special offers"
        monthly="$9"
        yearly="$80"
        btn="Contact sales"
        }}

        {{else}}

        {{#get "tiers" include="monthly_price,yearly_price,benefits" limit="all"}}
        {{#if tiers}}
        {{#foreach tiers}}
        {{> "pricing-card"}}
        {{/foreach}}
        {{else}}
        <div class="col-span-full text-center text-sm text-gray-600">
          No membership tiers found.
        </div>
        {{/if}}
        {{/get}}

        {{/match}}

      </div>
    </div>
  </section>

  <div class="prose mx-auto py-15 max-w-[1255px] page-content">
    {{content}}
  </div>

  <script>
    (function () {
      const toggles = Array.from(document.querySelectorAll(".js-billing-toggle"));

      function setBilling(mode) {
        toggles.forEach(btn => {
          const active = btn.dataset.billing === mode;
          btn.classList.toggle("bg-black", active);
          btn.classList.toggle("text-white", active);
          btn.classList.toggle("text-gray-700", !active);
          btn.classList.toggle("hover:bg-gray-100", !active);
        });

        document.querySelectorAll("[data-plan]").forEach(card => {
          const m = card.getAttribute("data-monthly");
          const y = card.getAttribute("data-yearly");
          const priceEl = card.querySelector(".js-price");
          const suffixEl = card.querySelector(".js-suffix");
          if (!priceEl) return;

          if (mode === "yearly" && y) {
            priceEl.textContent = y;
            if (suffixEl) suffixEl.textContent = card.getAttribute("data-yearly-suffix") || "/ per year";
          } else {
            priceEl.textContent = m || y || "0";
            if (suffixEl) suffixEl.textContent = (m ? (card.getAttribute("data-monthly-suffix") || "/ per month")
              : (y ? (card.getAttribute("data-yearly-suffix") || "/ per year") : ""));
          }
        });
      }

      setBilling("monthly");
      toggles.forEach(btn => btn.addEventListener("click", () => setBilling(btn.dataset.billing)));
    })();
  </script>
  </main>

  {{/post}}
